<?xml version="1.0" encoding="utf-8"?>
<!-- One Plex call per task. op names a logical request; results come back in the same item shape the screens use. -->
<component name="PlexTask" extends="Task">
  <interface>
    <field id="op" type="string" />
    <field id="args" type="assocarray" />
    <field id="tag" type="string" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="ok" type="boolean" />
    <field id="response" type="assocarray" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/PlexTask.brs" />
</component>
