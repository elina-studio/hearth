<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen playback with resume, Hearth's own pause screen, side sheets, chapters and subtitles. -->
<component name="PlayerScreen" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" />
    <SubLayer id="subs" />
    <Label id="status" translation="[96, 980]" width="1728" color="0xB5AF8CFF" text="Lighting the lantern..." />
    <Timer id="tick" duration="10" repeat="true" />
    <PauseOverlay id="overlay" />
    <ChapterStrip id="chapters" />
    <PlayerSheet id="sheet" />
    <SkipButton id="skip" />
    <UpNextCard id="upnext" />
    <SubsFinder id="finder" context="player" />
    <SubsAuto id="auto" />
  </children>
  <interface>
    <field id="item" type="assocarray" onChange="start" />
    <field id="resume" type="boolean" />
    <!-- what plays after this one finishes (shuffle, a season from the start), from the details page -->
    <field id="queue" type="array" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/playback.brs" />
  <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/playerui.brs" />
</component>
