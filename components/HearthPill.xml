<?xml version="1.0" encoding="utf-8"?>
<!-- Pill: dim when idle, gold ring for the current room, gold fill when focused. Also used as a button. -->
<component name="HearthPill" extends="Group">
  <children>
    <Poster id="base" uri="pkg:/images/pill.9.png" blendColor="0xFFFFFF14" visible="false" />
    <Poster id="fill" uri="pkg:/images/pill.9.png" blendColor="0xE0B34AFF" visible="false" />
    <Poster id="ring" uri="pkg:/images/pill-ring.9.png" blendColor="0xE0B34AFF" visible="false" />
    <Label id="label" horizAlign="center" vertAlign="center" color="0xB5AF8CFF" />
  </children>
  <interface>
    <field id="text" type="string" onChange="update" />
    <field id="width" type="integer" value="0" onChange="update" />
    <field id="height" type="integer" value="58" onChange="update" />
    <field id="focused" type="boolean" value="false" onChange="update" />
    <field id="current" type="boolean" value="false" onChange="update" />
    <field id="button" type="boolean" value="false" onChange="update" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/HearthPill.brs" />
</component>
