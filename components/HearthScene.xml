<?xml version="1.0" encoding="utf-8"?>
<!-- Root scene: saved login, a stack of screens (Setup or Hub at the bottom, then Details, Player). -->
<component name="HearthScene" extends="Scene">
  <children>
    <Poster id="bg" uri="pkg:/images/bg.jpg" width="1920" height="1080" />
    <Group id="stack" />
    <ContinueRibbon id="ribbon" />
    <!-- menu sounds: thumb piano, one node per sound so a fast tick never cuts off a pluck (Roku plays up to 4 at once) -->
    <SoundEffect id="sfxMove" uri="pkg:/sounds/ui-move.wav" volume="50" />
    <SoundEffect id="sfxSelect" uri="pkg:/sounds/ui-select.wav" volume="50" />
    <SoundEffect id="sfxBack" uri="pkg:/sounds/ui-back.wav" volume="50" />
    <SoundEffect id="sfxDead" uri="pkg:/sounds/ui-deadend.wav" volume="50" />
  </children>
  <interface>
    <field id="sheet" type="node" />
    <field id="exitApp" type="boolean" value="false" />
    <field id="request" type="assocarray" alwaysNotify="true" onChange="onRequest" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/HearthScene.brs" />
</component>
