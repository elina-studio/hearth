<?xml version="1.0" encoding="utf-8"?>
<!-- Pause screen, layout A "Hearthstone bar" (mockups/player/pause-A-hearthstone-bar.png).
     The player sets info, duration and position, and calls open(); the overlay sends what to do through `action`:
     { cmd: "seek", to: seconds } | { cmd: "toggle" } | { cmd: "play" } | { cmd: "button", id: "cc" | "audio" | ... } | { cmd: "hidden" } -->
<component name="PauseOverlay" extends="Group">
  <children>
    <Poster id="shadeTop" uri="pkg:/images/player/shade-top.png" width="1920" height="260" />
    <Poster id="shadeBottom" uri="pkg:/images/player/shade-bottom.png" translation="[0, 560]" width="1920" height="520" />
    <Label id="kicker" translation="[100, 64]" width="1400" color="0xE0B34AFF" />
    <Label id="title" translation="[100, 100]" width="1400" maxLines="1" color="0xEDE6CAFF" />
    <Label id="clock" translation="[1520, 60]" width="300" horizAlign="right" color="0xEDE6CAFF" />
    <Label id="ampm" translation="[1520, 112]" width="300" horizAlign="right" color="0xB5AF8CFF" />
    <Group id="preview" visible="false">
      <Rectangle id="thumbBg" width="320" height="180" color="0x141A11FF" />
      <Poster id="thumb" width="320" height="180" loadDisplayMode="scaleToZoom" />
      <Poster id="thumbRing" uri="pkg:/images/w/focus-ring-334x194.png" translation="[-27, -27]" width="374" height="234" />
      <Label id="thumbTime" translation="[0, 196]" width="320" horizAlign="center" color="0xFFE7A0FF" />
    </Group>
    <Label id="elapsed" translation="[100, 800]" width="190" color="0xEDE6CAFF" />
    <Group id="barHolder" translation="[300, 832]" />
    <Poster id="head" uri="pkg:/images/player/scrub-head.png" width="48" height="48" />
    <Label id="remaining" translation="[1600, 800]" width="220" horizAlign="right" color="0xB5AF8CFF" />
    <Poster id="moon" uri="pkg:/images/player/moon.png" width="24" height="24" blendColor="0xB5AF8CFF" />
    <Label id="ends" translation="[1300, 882]" width="520" horizAlign="right" color="0xB5AF8CFF" />
    <Group id="buttons" translation="[0, 912]" />
    <KeyHints id="hints" translation="[1820, 1016]" />
    <Timer id="hideTimer" duration="5" />
    <Timer id="scrubTimer" duration="0.25" repeat="true" />
    <Timer id="clockTimer" duration="15" repeat="true" />
  </children>
  <interface>
    <field id="info" type="assocarray" onChange="onInfo" />
    <field id="duration" type="float" />
    <field id="position" type="float" onChange="onPosition" />
    <field id="playing" type="boolean" onChange="onPlaying" />
    <field id="canNext" type="boolean" onChange="buildButtons" />
    <field id="bifUrl" type="string" onChange="onBifUrl" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <function name="open" />
    <function name="close" />
    <function name="nudge" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PauseOverlay.brs" />
</component>
