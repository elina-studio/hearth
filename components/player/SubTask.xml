<?xml version="1.0" encoding="utf-8"?>
<!-- Downloads a text subtitle (SRT or WebVTT) and parses it into cues for SubLayer. -->
<component name="SubTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="cues" type="array" />
    <field id="ok" type="boolean" />
    <field id="done" type="boolean" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/player/SubTask.brs" />
</component>
