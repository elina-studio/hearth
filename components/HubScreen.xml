<?xml version="1.0" encoding="utf-8"?>
<!-- The hub: room pills, clock, and the current room underneath. -->
<component name="HubScreen" extends="Group">
  <children>
    <!-- launch warm-up: rooms wait here, in the render tree but far off screen, so their posters really load (a room that is
         not in the tree gets no images). showRoom moves a room out of here the first time it is opened. -->
    <Group id="warmHolder" translation="[-6000, 150]" />
    <Group id="roomHolder" translation="[0, 150]" />
    <!-- solid, so rows scrolling up never show through behind the room names (UX review item 11) -->
    <Rectangle id="topShade" width="1920" height="150" color="0x0B0E09FF" />
    <!-- its bottom edge is hand-cut, not ruler-straight (tools/art/header_edge.py) -->
    <Poster id="topEdge" uri="pkg:/images/w/rough/header-edge.png" translation="[0, 150]" width="1920" height="20" blendColor="0x0B0E09FF" />
    <!-- room bar (whimsy spec 2-3): pre-rendered DW Pica caps labels centred on 960; the settled room gets a glow,
         the firefly and two small friends; on the bar one firefly follows focus -->
    <Poster id="flyGlow" uri="pkg:/images/w/firefly-glow.png" height="62" />
    <Group id="pills" />
    <Poster id="flyFriend1" uri="pkg:/images/w/firefly-small.png" width="48" height="48" />
    <Poster id="flyFriend2" uri="pkg:/images/w/firefly-small.png" width="48" height="48" opacity="0.45" />
    <Poster id="flyMain" uri="pkg:/images/w/firefly-main.png" width="64" height="64" />
    <Animation id="flyMove" duration="0.18" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="flyTo" key="[0.0, 1.0]" fieldToInterp="flyMain.translation" />
    </Animation>
    <Animation id="friendsIn" duration="0.25" easeFunction="linear">
      <FloatFieldInterpolator id="f1In" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="flyFriend1.opacity" />
      <FloatFieldInterpolator id="f2In" key="[0.0, 1.0]" keyValue="[0.0, 0.45]" fieldToInterp="flyFriend2.opacity" />
    </Animation>
    <!-- clock B "twig and sprig": time in Cinzel, a short wild twig with two leaves, one steady firefly,
         then a fine gold weather icon and the weather in a book serif. All right-aligned to x 1824. -->
    <Label id="clock" translation="[1700, 12]" color="0xEDE6CAFF" />
    <Poster id="clockFly" uri="pkg:/images/firefly.png" width="16" height="16" translation="[1660, 40]" />
    <Poster uri="pkg:/images/clock/twig.png" translation="[1629, 56]" width="200" height="56" />
    <Poster id="wxIcon" translation="[1500, 100]" width="28" height="28" blendColor="0xE0B34AFF" visible="false" />
    <Label id="weather" translation="[1540, 96]" height="36" vertAlign="center" color="0xB5AF8CFF" />
    <!-- now playing chip (audit idea 2A): left of the clock while music plays and Music is not the room.
         Display only, never focused. HubScreen.layoutChip sizes it and right-aligns it to the clock. -->
    <Group id="npChip" translation="[1474, 35]" visible="false">
      <Poster id="npBack" uri="pkg:/images/pill-v2.9.png" height="56" blendColor="0xFFFFFF14" />
      <Rectangle translation="[6, 6]" width="44" height="44" color="0x2A2620FF" visible="false" id="npArtBack" />
      <Poster id="npArt" translation="[6, 6]" width="44" height="44" loadDisplayMode="scaleToZoom" />
      <Label id="npTitle" translation="[60, 5]" height="26" vertAlign="center" maxLines="1" color="0xEDE6CAFF" />
      <Label id="npArtist" translation="[60, 29]" height="22" vertAlign="center" maxLines="1" color="0xB5AF8CFF" />
      <Group id="npBars">
        <Rectangle id="npB0" translation="[0, 0]" width="3" height="20" color="0xE0B34AFF" scaleRotateCenter="[1.5, 20]" scale="[1, 0.5]" />
        <Rectangle id="npB1" translation="[5, 0]" width="3" height="20" color="0xE0B34AFF" scaleRotateCenter="[1.5, 20]" scale="[1, 1]" />
        <Rectangle id="npB2" translation="[10, 0]" width="3" height="20" color="0xE0B34AFF" scaleRotateCenter="[1.5, 20]" scale="[1, 0.7]" />
        <Rectangle id="npB3" translation="[15, 0]" width="3" height="20" color="0xE0B34AFF" scaleRotateCenter="[1.5, 20]" scale="[1, 0.9]" />
      </Group>
    </Group>
    <Animation id="npPulse" duration="1.6" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[[1, 0.5], [1, 0.9], [1, 0.35], [1, 0.75], [1, 0.5]]" fieldToInterp="npB0.scale" />
      <Vector2DFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[[1, 1.0], [1, 0.45], [1, 0.8], [1, 0.6], [1, 1.0]]" fieldToInterp="npB1.scale" />
      <Vector2DFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[[1, 0.7], [1, 1.0], [1, 0.5], [1, 0.95], [1, 0.7]]" fieldToInterp="npB2.scale" />
      <Vector2DFieldInterpolator key="[0.0, 0.25, 0.5, 0.75, 1.0]" keyValue="[[1, 0.9], [1, 0.6], [1, 1.0], [1, 0.4], [1, 0.9]]" fieldToInterp="npB3.scale" />
    </Animation>
    <Label id="buildTag" translation="[1524, 136]" width="300" horizAlign="right" color="0xB5AF8C55" />
    <Timer id="clockTimer" duration="20" repeat="true" />
    <Timer id="weatherTimer" duration="900" repeat="true" />
    <Timer id="previewTimer" duration="0.33" repeat="false" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- true once every room has its first data (launch warm-up) -->
    <field id="warm" type="boolean" value="false" />
    <field id="room" type="string" value="Home" />
    <function name="onShown" />
    <function name="remoteGo" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/photos.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/HubScreen.brs" />
</component>
