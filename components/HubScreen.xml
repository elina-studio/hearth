<?xml version="1.0" encoding="utf-8"?>
<!-- The hub: room pills, clock, and the current room underneath. -->
<component name="HubScreen" extends="Group">
  <children>
    <Group id="roomHolder" translation="[0, 150]" />
    <Rectangle id="topShade" width="1920" height="150" color="0x0B0E09E6" />
    <!-- room bar (whimsy spec 2-3): pre-rendered DW Pica caps labels centred on 960; the settled room gets a glow,
         the firefly and two small friends; on the bar one firefly follows focus -->
    <Poster id="flyGlow" uri="pkg:/images/w/firefly-glow.png" height="62" />
    <Group id="pills" />
    <Poster id="flyFriend1" uri="pkg:/images/w/firefly-small.png" width="48" height="48" />
    <Poster id="flyFriend2" uri="pkg:/images/w/firefly-small.png" width="48" height="48" opacity="0.45" />
    <Poster id="flyMain" uri="pkg:/images/w/firefly-main.png" width="64" height="64" />
    <Animation id="flyMove" duration="0.18" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="flyTo" key="[0.0, 1.0]" fieldToInterp="flyMain.translation" />
    </Animation>
    <Animation id="friendsIn" duration="0.25" easeFunction="linear">
      <FloatFieldInterpolator id="f1In" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="flyFriend1.opacity" />
      <FloatFieldInterpolator id="f2In" key="[0.0, 1.0]" keyValue="[0.0, 0.45]" fieldToInterp="flyFriend2.opacity" />
    </Animation>
    <!-- clock B "twig and sprig": time in Cinzel, a short wild twig with two leaves, one steady firefly,
         then a fine gold weather icon and the weather in a book serif. All right-aligned to x 1824. -->
    <Label id="clock" translation="[1700, 12]" color="0xEDE6CAFF" />
    <Poster id="clockFly" uri="pkg:/images/firefly.png" width="16" height="16" translation="[1660, 40]" />
    <Poster uri="pkg:/images/clock/twig.png" translation="[1629, 56]" width="200" height="56" />
    <Poster id="wxIcon" translation="[1500, 100]" width="28" height="28" blendColor="0xE0B34AFF" visible="false" />
    <Label id="weather" translation="[1540, 96]" height="36" vertAlign="center" color="0xB5AF8CFF" />
    <Label id="buildTag" translation="[1524, 136]" width="300" horizAlign="right" color="0xB5AF8C55" />
    <Timer id="clockTimer" duration="20" repeat="true" />
    <Timer id="weatherTimer" duration="900" repeat="true" />
    <Timer id="previewTimer" duration="0.33" repeat="false" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
    <function name="remoteGo" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/photos.brs" />
  <script type="text/brightscript" uri="pkg:/components/HubScreen.brs" />
</component>
