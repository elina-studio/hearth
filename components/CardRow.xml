<?xml version="1.0" encoding="utf-8"?>
<!-- A titled row of cards. The parent owns focus and calls move(); OK handling stays with the parent. -->
<component name="CardRow" extends="Group">
  <children>
    <!-- section header (whimsy spec 7): gold line icon, Fell italic title, a wild twig, count at the right end -->
    <Poster id="twig" />
    <Poster id="icon" translation="[4, 2]" width="36" height="36" blendColor="0xE0B34AFF" visible="false" />
    <Label id="title" color="0xEDE6CAFF" translation="[68, -6]" />
    <Label id="count" color="0xB5AF8CFF" horizAlign="right" />
    <Group id="clip" translation="[0, 74]">
      <Group id="strip" />
    </Group>
  </children>
  <interface>
    <field id="title" type="string" onChange="onTitle" />
    <field id="icon" type="string" onChange="onTitle" />
    <!-- e.g. "new": the header ends with "12 NEW" -->
    <field id="countNoun" type="string" onChange="onTitle" />
    <!-- 0-3: which twig this row uses, fixed per row -->
    <field id="seed" type="integer" value="0" onChange="onTitle" />
    <field id="cards" type="array" onChange="build" />
    <field id="cardWidth" type="integer" value="320" />
    <field id="cardHeight" type="integer" value="180" />
    <field id="showCaption" type="boolean" value="true" />
    <field id="index" type="integer" value="0" />
    <field id="active" type="boolean" value="false" onChange="paint" />
    <field id="rowHeight" type="integer" />
    <field id="viewWidth" type="integer" value="1728" />
    <!-- optional image laid over each picture, e.g. a round cut-out for artist photos; set before cards -->
    <field id="maskUri" type="string" />
    <!-- round artist cards: the images arrive already cut to a circle (see pxRound); this only rounds the focus ring -->
    <field id="roundCards" type="boolean" value="false" />
    <!-- true in the Music room: gold focus ring only, no moss -->
    <field id="noMoss" type="boolean" value="false" />
    <function name="move" />
    <function name="current" />
    <function name="count" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/CardRow.brs" />
</component>
