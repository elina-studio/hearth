<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the episode list (details mockup A): number, thumb with braid, title, one-line synopsis,
     date and time left, and status on the right (watched tick, "No English", "To 720p").
     The row box is 1744x120 starting at (-12, -8); DetailsScreen reuses a few of these as the list scrolls. -->
<component name="EpisodeRow" extends="Group">
  <children>
    <Poster id="bg" uri="pkg:/images/w/panel.9.png" translation="[-24, -20]" width="1768" height="144" blendColor="0x1A2114FF" visible="false" />
    <Label id="num" translation="[0, 30]" width="56" horizAlign="right" color="0xB5AF8CFF" />
    <Rectangle translation="[76, 2]" width="184" height="104" color="0x1D2418FF" />
    <Poster id="thumb" translation="[76, 2]" width="184" height="104" loadDisplayMode="scaleToZoom" />
    <Group id="braidAt" translation="[76, 94]" />
    <Label id="title" translation="[284, 2]" width="1080" maxLines="1" color="0xEDE6CAFF" />
    <Label id="syn" translation="[284, 42]" width="1100" maxLines="1" color="0xB5AF8CFF" />
    <Label id="meta" translation="[284, 76]" width="1100" maxLines="1" color="0xB5AF8CFF" />
    <LayoutGroup id="status" translation="[1700, 38]" layoutDirection="horiz" horizAlignment="right" vertAlignment="center" itemSpacings="[10]" />
    <Poster id="ring" uri="pkg:/images/w/focus-ring.9.png" translation="[-39, -35]" width="1798" height="174" visible="false" />
    <Poster id="moss" translation="[1631, -64]" width="125" height="96" visible="false" />
  </children>
  <interface>
    <!-- { number, title, synopsis, meta, pct, watched, missing, hevc, image, key } -->
    <field id="data" type="assocarray" onChange="draw" />
    <field id="focused" type="boolean" value="false" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/details/tags.brs" />
  <script type="text/brightscript" uri="pkg:/components/details/EpisodeRow.brs" />
</component>
