<?xml version="1.0" encoding="utf-8"?>
<!-- Right-hand side sheet (More menu, layout A, picked Nov 23; mockups/details/M-A-side-sheet.png).
     Also used for the episode options, audio tracks, file info, fix match, person titles and season requests.
     Host: set heading/icon/rows, call open. rows: [{ header } | { icon, label, sub, action, data, stars, checked }]
     result: the chosen row (with .stars updated for a rating row). -->
<component name="SideSheet" extends="Group">
  <children>
    <Rectangle id="shade" width="1920" height="1080" color="0x0B0E09D0" />
    <Poster uri="pkg:/images/w/panel.9.png" translation="[1168, 28]" width="684" height="1024" blendColor="0x141A11FF" />
    <Poster id="hIcon" translation="[1220, 84]" width="36" height="36" blendColor="0xE0B34AFF" />
    <Label id="heading" translation="[1272, 70]" width="540" maxLines="1" color="0xEDE6CAFF" />
    <Label id="note" translation="[1220, 132]" width="600" maxLines="2" wrap="true" lineSpacing="2" color="0xB5AF8CFF" />
    <Group id="list" translation="[1206, 160]" />
    <Label id="more" translation="[1220, 958]" width="600" color="0xB5AF8CFF" />
    <Label id="hint" translation="[1220, 994]" width="600" color="0xB5AF8CFF" />
  </children>
  <interface>
    <field id="heading" type="string" />
    <field id="icon" type="string" value="more" />
    <field id="note" type="string" />
    <field id="rows" type="array" />
    <field id="result" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <function name="open" />
    <function name="close" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/details/SideSheet.brs" />
</component>
