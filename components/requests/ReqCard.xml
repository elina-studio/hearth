<?xml version="1.0" encoding="utf-8"?>
<!-- One poster in the Requests grid: poster (or title when there's none), a status band across its foot with an icon, and a download bar. -->
<component name="ReqCard" extends="Group">
  <children>
    <Rectangle id="bg" width="180" height="270" color="0x1D2418FF" />
    <Label id="fallback" translation="[12, 10]" width="156" height="250" wrap="true" lineSpacing="2" horizAlign="center" vertAlign="center" color="0xEDE6CAFF" />
    <Poster id="poster" width="180" height="270" loadWidth="180" loadHeight="270" loadDisplayMode="scaleToZoom" />
    <Group id="score" translation="[104, 8]" visible="false">
      <Rectangle width="68" height="30" color="0x0B0E09D0" />
      <Poster uri="pkg:/images/requests/star.png" width="16" height="16" translation="[7, 7]" blendColor="0xE0B34AFF" />
      <Label id="scoreText" translation="[28, 0]" width="38" height="30" vertAlign="center" color="0xE0B34AFF" />
    </Group>
    <Group id="tile" visible="false">
      <Poster uri="pkg:/images/tile.9.png" blendColor="0xFFFFFF0F" width="180" height="270" />
      <Poster id="tileIcon" translation="[58, 70]" width="64" height="64" blendColor="0xE0B34AFF" />
      <Label id="tileTitle" translation="[0, 150]" width="180" horizAlign="center" color="0xE0B34AFF" />
      <Label id="tileSub" translation="[14, 190]" width="152" wrap="true" lineSpacing="2" maxLines="2" horizAlign="center" color="0xB5AF8CFF" />
    </Group>
    <Group id="chip" translation="[0, 270]">
      <Rectangle id="chipBg" width="180" height="40" />
      <Group id="chipInner">
        <Poster id="chipIcon" width="20" height="20" translation="[0, 10]" />
        <Label id="chipText" translation="[26, 0]" height="40" vertAlign="center" />
      </Group>
    </Group>
    <Group id="bar" translation="[0, 318]" visible="false">
      <Poster id="track" uri="pkg:/images/w/progress-track.9.png" width="180" height="12" />
      <Group id="clip" translation="[1, 1]" clippingRect="[0, 0, 0, 10]">
        <Poster uri="pkg:/images/w/progress-fill-body.png" width="512" height="10" />
      </Group>
      <Poster id="tip" uri="pkg:/images/w/progress-fill-tip.png" width="12" height="10" visible="false" />
    </Group>
    <Label id="cap" translation="[0, 340]" width="180" height="26" />
    <Label id="capSub" translation="[0, 368]" width="180" height="26" />
    <Poster id="ring" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[-10, -10]" width="200" height="330" visible="false" />
  </children>
  <interface>
    <field id="card" type="assocarray" onChange="draw" />
    <field id="focused" type="boolean" value="false" onChange="onFocused" />
    <field id="load" type="boolean" value="false" onChange="onLoad" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/ReqCard.brs" />
</component>
