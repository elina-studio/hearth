<?xml version="1.0" encoding="utf-8"?>
<!-- One Overseerr call. mode "call": method/path/query/body. mode "requests": the request list plus each title's details. -->
<component name="OverseerrTask" extends="Task">
  <interface>
    <field id="mode" type="string" value="call" />
    <field id="method" type="string" value="GET" />
    <field id="path" type="string" />
    <field id="query" type="assocarray" />
    <field id="body" type="assocarray" />
    <!-- JSON text for POST bodies; an assocarray field can lose the keys' capitals, which Overseerr rejects -->
    <field id="bodyText" type="string" />
    <field id="tag" type="string" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="response" type="assocarray" />
    <field id="ok" type="boolean" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/OverseerrTask.brs" />
</component>
