<?xml version="1.0" encoding="utf-8"?>
<!-- Requests: a rail of lists on the left (Search first), a poster grid on the right, and a request popup.
     Overseerr does the work; the API key lives only on the TV (registry "hearth" / "overseerrKey"). -->
<component name="RequestsRoom" extends="Group">
  <children>
    <Group id="main">
      <Group id="rail" translation="[96, 20]" />
      <Group id="header" translation="[540, 6]">
        <Label id="eyebrow" color="0xD9A066FF" />
        <Poster id="star" uri="pkg:/images/requests/star.png" width="22" height="22" blendColor="0xD9A066FF" visible="false" />
        <Label id="rating" color="0xD9A066FF" />
        <Label id="title" translation="[0, 34]" width="1280" maxLines="1" color="0xEDE6CAFF" />
      </Group>
      <Group id="tabs" translation="[540, 128]" visible="false" />
      <Label id="moreText" translation="[1260, 20]" width="520" horizAlign="right" text="Loading more…" color="0xB5AF8CFF" visible="false" />
      <Group id="filterBar" translation="[540, 128]" visible="false">
        <Poster id="barBg" uri="pkg:/images/pill.9.png" width="236" height="52" blendColor="0xFFFFFF12" />
        <Poster id="barIcon" uri="pkg:/images/requests/list.png" width="24" height="24" translation="[22, 14]" blendColor="0xEDE6CAFF" />
        <Label id="barLabel" translation="[58, 0]" height="52" vertAlign="center" text="Filter &amp; sort" color="0xEDE6CAFF" />
        <Poster id="barRing" uri="pkg:/images/pill-ring.9.png" blendColor="0xFFF3D0FF" translation="[-5, -5]" width="246" height="62" visible="false" />
        <!-- summary, then (filters on) "Filtered · 43 of 100" and a "* change" hint, laid out left to right -->
        <LayoutGroup id="barLine" translation="[262, 26]" layoutDirection="horiz" vertAlignment="center" itemSpacings="[20, 24, 10]">
          <Label id="barSum" height="52" vertAlign="center" color="0xEDE6CAFF" />
          <Label id="barCount" height="52" vertAlign="center" color="0xB5AF8CFF" />
          <Group id="barHintKey">
            <Poster uri="pkg:/images/pill.9.png" width="38" height="34" translation="[0, -17]" blendColor="0xFFFFFF1E" />
            <Poster uri="pkg:/images/icons/icon-asterisk.png" width="18" height="18" translation="[10, -9]" blendColor="0xEDE6CAFF" />
          </Group>
          <Label id="barHint" height="52" vertAlign="center" text="change" color="0xB5AF8CFF" />
        </LayoutGroup>
      </Group>
      <Group id="gridClip" translation="[540, 140]" clippingRect="[-14, -14, 1310, 800]">
        <Group id="grid" />
      </Group>
      <Label id="empty" translation="[540, 160]" width="1200" wrap="true" color="0xB5AF8CFF" />
      <Group id="musicPanel" translation="[540, 140]" visible="false">
        <Poster uri="pkg:/images/tile.9.png" blendColor="0xFFFFFF0F" width="700" height="330" />
        <Poster uri="pkg:/images/requests/note.png" translation="[50, 50]" width="80" height="80" blendColor="0xE0B34AFF" />
        <Label id="musicTitle" translation="[50, 160]" text="ASK LIDARR FOR AN ARTIST" color="0xE0B34AFF" />
        <Label id="musicSub" translation="[50, 214]" width="600" wrap="true" color="0xB5AF8CFF" text="Press OK to type an artist. Lidarr adds them and looks for their albums." />
      </Group>
      <Group id="searchPanel" translation="[540, 20]" visible="false">
        <HearthKeyboard id="kb" placeholder="Type a title" />
        <Label id="resultsHead" translation="[600, 0]" width="690" color="0xB5AF8CFF" />
        <Group id="results" translation="[600, 56]" />
      </Group>
    </Group>
    <Group id="setup" visible="false" translation="[96, 20]">
      <Label id="setupText" width="1000" wrap="true" color="0xB5AF8CFF" />
      <HearthKeyboard id="keyKb" translation="[1174, 0]" mode="full" placeholder="Paste or type the key" />
      <HearthPill id="saveKey" translation="[1174, 740]" width="554" text="Save key" button="true" />
    </Group>
    <Group id="toast" translation="[96, 840]" visible="false">
      <Poster id="toastBg" uri="pkg:/images/tile.9.png" blendColor="0x141A11FF" height="76" />
      <Poster id="toastIcon" translation="[26, 23]" width="30" height="30" blendColor="0xE0B34AFF" />
      <Label id="toastText" translation="[72, 0]" height="76" vertAlign="center" color="0xEDE6CAFF" />
      <Label id="toastHint" height="76" vertAlign="center" color="0xB5AF8CFF" />
    </Group>
    <Group id="popupHolder" />
    <Group id="sheetHolder" />
    <Timer id="toastTimer" duration="4" />
    <Timer id="undoTimer" duration="1" repeat="true" />
    <Timer id="detailTimer" duration="0.4" />
    <Timer id="searchTimer" duration="0.5" />
    <Timer id="pollTimer" duration="10" repeat="true" control="start" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- set once the first data has arrived (or there is nothing to load); the launch warm-up waits for it -->
    <field id="ready" type="boolean" value="false" />
    <!-- set by the hub (from Search) to run an Overseerr search right away -->
    <field id="searchTerm" type="string" alwaysNotify="true" onChange="onSearchTerm" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/reqdata.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/RequestsRoom.brs" />
</component>
