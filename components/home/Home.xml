<?xml version="1.0" encoding="utf-8"?>
<component name="Home" extends="JFScreen">
  <children>
    <Poster id="backdrop" loadDisplayMode="scaleToZoom" width="1920" height="1200" />

    <!-- Hearth: room pills. Up from the rows reaches them; Left/Right wrap; OK or Down enters the room. -->
    <LayoutGroup id="buttons" translation="[100, 100]" layoutDirection="horiz" horizAlignment="left" itemSpacings="[12]">
      <TextButton id="pillHome" text="Home" fontSize="28" padding="24" height="56" width="130" />
      <TextButton id="pillMovies" text="Movies" fontSize="28" padding="24" height="56" width="160" />
      <TextButton id="pillShows" text="Shows" fontSize="28" padding="24" height="56" width="150" />
      <TextButton id="pillMusic" text="Music" fontSize="28" padding="24" height="56" width="140" />
      <TextButton id="pillRequests" text="Requests" fontSize="28" padding="24" height="56" width="190" />
      <TextButton id="pillAmbiance" text="Ambiance" fontSize="28" padding="24" height="56" width="200" />
      <TextButton id="pillPhotos" text="Photos" fontSize="28" padding="24" height="56" width="160" />
      <TextButton id="pillSearch" text="Search" fontSize="28" padding="24" height="56" width="190" icon="pkg:/images/icons/search-light.png" focusIcon="pkg:/images/icons/search-light.png" iconSide="left" />
    </LayoutGroup>

    <HomeRows
      id="homeRows"
      showRowLabel="true"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="fixedFocusWrap"
      itemComponentName="HomeItem"
      numRows="2"
      rowLabelOffset="[[0,20]]" />
    <OptionsSlider id="options" />

    <Animation id="toggleButtonsAnimation" duration=".7" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="buttonsFade" key="[0.0, .6]" keyValue="[1.00, 0.00]" fieldToInterp="buttons.opacity" />
      <Vector2DFieldInterpolator id="buttonsMove" key="[0.1, .9]" keyValue="[[100, 100], [100, 0]]" fieldToInterp="buttons.translation" />
    </Animation>

  </children>
  <interface>
    <field id="playlistData" type="array" />
    <field id="selectedItem" alias="homeRows.selectedItem" />
    <field id="rowFocused" alias="homeRows.itemFocused" onchange="onRowFocusedChange" />
    <field id="quickPlayNode" alias="homeRows.quickPlayNode" />
    <function name="refresh" />
    <function name="loadLibraries" />
  </interface>
</component>