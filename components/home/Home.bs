import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/AnimationControl.bs"
import "pkg:/source/enums/AnimationState.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/VideoControl.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.isFirstRun = true
    m.top.overhangTitle = ""
    m.top.optionsAvailable = false
    m.postTask = createObject("roSGNode", "PostTask")

    m.favoritesOptionText = tr("Add To Favorites")

    m.loadItemsTask1 = createObject("roSGNode", "LoadItemsTask")
    m.loadItemsTask1.observeField("content", "onMyListLoaded")
    m.loadItemsTask1.itemsToLoad = "isInMyList"

    m.loadMetaDataTask = CreateObject("roSGNode", "LoadItemsTask")
    m.loadMetaDataTask.itemsToLoad = "metaData"
    m.loadMetaDataTask.observeField("content", "onMetaDataLoaded")

    m.homeRows = m.top.findNode("homeRows")
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.buttons = m.top.findNode("buttons")
    m.toggleButtonsAnimation = m.top.findNode("toggleButtonsAnimation")
    m.buttonsFade = m.top.findNode("buttonsFade")
    m.buttonsMove = m.top.findNode("buttonsMove")

    ' Hearth room pills, in order
    m.pillIds = ["pillHome", "pillMovies", "pillShows", "pillMusic", "pillRequests", "pillAmbiance", "pillPhotos", "pillSearch"]
    m.pills = []
    for each pillId in m.pillIds
        m.pills.push(m.top.findNode(pillId))
    end for
    m.pillIndex = 0

    ' Hearth dashboard
    m.dash = m.top.findNode("dash")
    m.dashRings = [m.top.findNode("heroRing"), m.top.findNode("nowRing"), m.top.findNode("reqRing")]
    m.dashIndex = 0
    m.heroItem = invalid
    m.heroArt = m.top.findNode("heroArt")
    m.heroEyebrow = m.top.findNode("heroEyebrow")
    m.heroTitle = m.top.findNode("heroTitle")
    m.heroBar = m.top.findNode("heroBar")
    m.nowArt = m.top.findNode("nowArt")
    m.nowEyebrow = m.top.findNode("nowEyebrow")
    m.nowTitle = m.top.findNode("nowTitle")
    m.nowSub = m.top.findNode("nowSub")
    setDashFonts()
    m.dashTimer = m.top.findNode("dashTimer")
    m.dashTimer.observeField("fire", "updateDash")
    m.dashTimer.control = "start"
    showDash(true)

    setButtonColors()
end sub

sub refresh()
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.homeRows.callFunc("updateHomeRows")
end sub

sub setButtonColors()
    ' Home is the current room on this screen
    for each pill in m.pills
        pill.current = false
        pill.focused = false
    end for
    m.pills[0].current = true
end sub

function hearthFont(bold as boolean, size as integer) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = bold ? "pkg:/fonts/AtkinsonHyperlegible-Bold.ttf" : "pkg:/fonts/AtkinsonHyperlegible-Regular.ttf"
    font.size = size
    return font
end function

sub setDashFonts()
    m.heroEyebrow.font = hearthFont(true, 24)
    m.heroTitle.font = hearthFont(true, 58)
    m.nowEyebrow.font = hearthFont(true, 22)
    m.nowTitle.font = hearthFont(true, 34)
    m.nowSub.font = hearthFont(false, 24)
    m.top.findNode("reqEyebrow").font = hearthFont(true, 22)
    m.top.findNode("reqBig").font = hearthFont(true, 64)
    m.top.findNode("reqSub").font = hearthFont(false, 24)
end sub

' Hearth: show the dashboard (rows pushed down) or hide it (rows move up to the top)
sub showDash(visible as boolean)
    m.dash.visible = visible
    if visible
        m.homeRows.translation = [111, 690]
    else
        m.homeRows.translation = [111, 180]
    end if
end sub

' Hearth: find the first item of a home row by its title
function firstItemOfRow(title as string) as object
    content = m.homeRows.content
    if not isValid(content) then return invalid
    for each row in content.getChildren(-1, 0)
        if isStringEqual(row.title, title) and row.getChildCount() > 0 then return row.getChild(0)
    end for
    return invalid
end function

' Hearth: refresh the Continue hero and the Now playing tile
sub updateDash()
    item = firstItemOfRow(tr("Continue Watching"))
    eyebrow = "CONTINUE"
    if not isValid(item)
        item = firstItemOfRow(tr("Next Up"))
        eyebrow = "NEXT UP"
    end if
    m.heroItem = item

    if isValid(item)
        json = item.json
        title = chainLookupReturn(json, "SeriesName", invalid) ?? chainLookupReturn(json, "Name", "")
        if isValid(chainLookup(json, "SeriesName"))
            eyebrow = `${eyebrow} · S${chainLookupReturn(json, "ParentIndexNumber", 0)} E${chainLookupReturn(json, "IndexNumber", 0)}`
        end if
        m.heroEyebrow.text = eyebrow
        m.heroTitle.text = title
        m.heroArt.uri = FirstItemImageURL(json, ["Backdrop", "Thumb", "Primary"], { maxWidth: 1060 })
        pct = chainLookupReturn(json, "UserData.PlayedPercentage", 0)
        if not isNumber(pct) then pct = 0
        m.heroBar.width = 520 * pct / 100
    else
        m.heroEyebrow.text = "WELCOME HOME"
        m.heroTitle.text = "Nothing to continue"
        m.heroArt.uri = ""
        m.heroBar.width = 0
    end if

    state = chainLookupReturn(m.global, "audioPlayer.state", "")
    current = invalid
    if isStringEqual(state, MediaPlaybackState.PLAYING) or isStringEqual(state, MediaPlaybackState.PAUSED) or isStringEqual(state, MediaPlaybackState.BUFFERING)
        current = m.global.queueManager.callFunc("getCurrentItem")
    end if
    if isValid(current) and isValid(current.json)
        m.nowEyebrow.text = isStringEqual(state, MediaPlaybackState.PAUSED) ? "PAUSED · PLAY RESUMES" : "NOW PLAYING · PLAY PAUSES"
        m.nowTitle.text = chainLookupReturn(current.json, "Name", "")
        m.nowSub.text = chainLookupReturn(current.json, "AlbumArtist", "") ?? ""
        m.nowArt.uri = FirstItemImageURL(current.json, ["Primary"], { maxWidth: 180 })
    else
        m.nowEyebrow.text = "MUSIC"
        m.nowTitle.text = "Nothing playing"
        m.nowSub.text = "OK opens your music"
        m.nowArt.uri = ""
    end if
end sub

' Hearth: focus a dashboard tile (0 hero, 1 now playing, 2 requests)
sub focusDash(i as integer)
    if i < 0 then i = 0
    if i > 2 then i = 2
    m.dashIndex = i
    unfocusPills()
    showDash(true)
    for k = 0 to 2
        m.dashRings[k].visible = (k = i)
    end for
    m.dash.setfocus(true)
    setLastFocus(m.dash)
end sub

sub unfocusDash()
    for each ring in m.dashRings
        ring.visible = false
    end for
end sub

sub toggleMusic()
    state = chainLookupReturn(m.global, "audioPlayer.state", "")
    if isStringEqual(state, MediaPlaybackState.PLAYING)
        m.global.audioPlayer.control = VideoControl.PAUSE
    else if isStringEqual(state, MediaPlaybackState.PAUSED)
        m.global.audioPlayer.control = VideoControl.RESUME
    end if
    updateDash()
end sub

' Hearth: move focus to pill i (wraps around)
sub focusPill(i as integer)
    count = m.pills.count()
    i = ((i mod count) + count) mod count
    unfocusDash()
    for each pill in m.pills
        pill.focused = false
    end for
    m.pillIndex = i
    m.pills[i].focused = true
    m.pills[i].setfocus(true)
    setLastFocus(m.pills[i])
end sub

sub unfocusPills()
    for each pill in m.pills
        pill.focused = false
    end for
end sub

' Hearth: open the room behind the focused pill
sub enterPill()
    pillId = m.pillIds[m.pillIndex]

    if isStringEqual(pillId, "pillHome")
        focusDash(0)
        return
    end if

    if isStringEqual(pillId, "pillSearch")
        m.top.getScene().jumpTo = { selectionType: "search" }
        return
    end if

    collectionTypes = { pillMovies: "movies", pillShows: "tvshows", pillMusic: "music" }
    if collectionTypes.doesExist(pillId)
        lib = m.homeRows.callFunc("findLibrary", collectionTypes[pillId])
        if isValid(lib)
            m.homeRows.selectedItem = lib
        else
            m.global.sceneManager.callFunc("userMessage", m.pills[m.pillIndex].text ?? "", tr("No library of this kind was found on your server."))
        end if
        return
    end if

    m.global.sceneManager.callFunc("userMessage", m.pills[m.pillIndex].text ?? "", "This room arrives in a later Hearth build.")
end sub

sub loadLibraries()
    m.homeRows.callFunc("loadLibraries")
end sub

' JFScreen hook called when the screen is displayed by the screen manager
sub OnScreenShown()
    m.homeRows.rowLabelColor = chainLookupReturn(m.global.session, "user.settings.colorHomeRowHeaders", ColorPalette.WHITE)

    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.visible = true
        overhang.title = ""
        ' Users without a profile picture get the placeholder
        userImageTag = chainLookup(m.global.session, "user.PrimaryImageTag")
        if isValidAndNotEmpty(userImageTag)
            overhang.currentUserProfileImage = UserImageURL(m.global.session.user.id, { "tag": userImageTag })
        else
            overhang.currentUserProfileImage = "pkg:/images/baseline_person_white_48dp.png"
        end if
        overhang.currentUser = m.global.session.user.name
    end if

    if isValid(m.top.lastFocus)
        if LCase(m.top.lastFocus.id) = "overhang"
            overhang.callFunc("highlightUser")
        end if
        m.top.lastFocus.setFocus(true)
    else
        ' Hearth: launch focus is the Continue hero
        focusDash(0)
    end if
    updateDash()

    if not m.isFirstRun
        if m.homeRows.callFunc("isFocusOnFavoriteRow")
            m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
            m.homeRows.callFunc("reloadFavorites")
        else
            refresh()
        end if
    end if

    ' post the device profile the first time this screen is loaded
    if m.isFirstRun
        m.isFirstRun = false
        m.postTask.arrayData = getDeviceCapabilities()
        m.postTask.apiUrl = "/Sessions/Capabilities/Full"
        m.postTask.control = "RUN"
        m.postTask.observeField("responseCode", "postFinished")
    end if
end sub

' JFScreen hook called when the screen is hidden by the screen manager
sub OnScreenHidden()
    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.callFunc("dehighlightUser")
        overhang.currentUser = ""
        overhang.title = ""
    end if
end sub

' Triggered by m.postTask after completing a post.
' Empty the task data when finished.
sub postFinished()
    m.postTask.unobserveField("responseCode")
    m.postTask.callFunc("empty")
end sub

sub onRowFocusedChange()
    if m.top.rowFocused > 0
        if m.buttons.opacity > 0
            toggleButtonsVisibility()
        end if
        return
    end if

    if m.buttons.opacity < 1
        toggleButtonsVisibility(true)
    end if
end sub

sub toggleButtonsVisibility(runInReverse = false as boolean)
    m.buttonsFade.reverse = runInReverse
    m.buttonsMove.reverse = runInReverse

    if not isStringEqual(m.toggleButtonsAnimation.state, AnimationState.RUNNING)
        m.toggleButtonsAnimation.control = AnimationControl.START
    end if
end sub

sub onMyListLoaded()
    isInMyListData = m.loadItemsTask1.content
    m.loadItemsTask1.content = []

    if not isValidAndNotEmpty(isInMyListData) then return

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])
    if not isValid(focusedItem) then return

    dialogData = []
    paramData = {
        id: focusedItem.LookupCI("id")
    }

    if isInMyListData[0]
        dialogData.push(tr("Remove From My List"))
    else
        if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET], focusedItem.LookupCI("type"))
            dialogData.push(tr("Add To My List"))
        end if
    end if

    if not inArray([ItemType.RADIOSTATION], focusedItem.LookupCI("type"))
        dialogData.push(m.favoritesOptionText)
    end if

    if not inArray([ItemType.COLLECTIONFOLDER, ItemType.RADIOSTATION, ItemType.CHANNEL, ItemType.FOLDER, ItemType.PLAYLIST, ItemType.PROGRAM, ItemType.TVCHANNEL, ItemType.USERVIEW], focusedItem.LookupCI("type"))
        dialogData.push(tr("Add To Playlist"))
    end if

    if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET, ItemType.AUDIOBOOK, ItemType.BOOK], focusedItem.LookupCI("type"))
        showBothOptions = false
        if isChainValid(focusedItem, "PlayedPercentage")
            if focusedItem.PlayedPercentage > 0
                showBothOptions = true
            end if
        end if

        if showBothOptions
            dialogData.push(tr("Mark As Unplayed"))
            dialogData.push(tr("Mark As Played"))
        else
            if isChainValid(focusedItem, "isWatched")
                if focusedItem.isWatched
                    dialogData.push(tr("Mark As Unplayed"))
                else
                    dialogData.push(tr("Mark As Played"))
                end if
            end if
        end if
    end if

    if inArray([ItemType.EPISODE, ItemType.SEASON], focusedItem.LookupCI("type"))
        dialogData.push(tr("Go To Series"))
        dialogData.push(tr("Go To Season"))
        paramData.SeasonId = focusedItem.json.LookupCI("SeasonId")
        paramData.SeriesId = focusedItem.json.LookupCI("SeriesId")
    end if

    if inArray([ItemType.MUSICALBUM], focusedItem.LookupCI("type"))
        dialogData.push(tr("Play Instant Mix"))
        dialogData.push(tr("Go To Artist"))

        genreData = focusedItem.json.LookupCI("Genre")
        if isValidAndNotEmpty(genreData)
            if isValidAndNotEmpty(genreData[0])
                if isValidAndNotEmpty(genreData[0].Name)
                    dialogData.push(tr("Go To Genre") + `: ${genreData[0].LookupCI("Name")}`)
                    paramData.GenreName = genreData[0].LookupCI("Name")
                    paramData.GenreId = genreData[0].LookupCI("Id")
                    paramData.LibraryId = chainLookup(focusedItem, "json.LibraryId")
                end if
            end if
        end if

        paramData.ArtistId = focusedItem.json.LookupCI("AlbumArtistId")
        paramData.ArtistName = focusedItem.json.LookupCI("albumartist")
        paramData.AlbumId = focusedItem.LookupCI("id")
    end if

    m.global.sceneManager.callFunc("optionDialog", "libraryitem", focusedItem.LookupCI("title") ?? tr("Options"), [], dialogData, paramData)
end sub

sub setLastFocus(lastFocusElement)
    group = m.global.sceneManager.callFunc("getActiveScene")

    if isValid(group)
        group.lastFocus = lastFocusElement
    end if
end sub

function audioMiniPlayerIsVisibleInScene()
    scene = m.top.getScene()
    audioMiniPlayer = scene.findNode("audioMiniPlayer")

    if not isValid(audioMiniPlayer) then return false

    return audioMiniPlayer.callFunc("isVisible")
end function

' Special handling for key presses on the home screen.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.dash.isInFocusChain()
        if isStringEqual(key, KeyCode.LEFT)
            focusDash(m.dashIndex - 1)
            return true
        end if
        if isStringEqual(key, KeyCode.RIGHT)
            focusDash(m.dashIndex + 1)
            return true
        end if
        if isStringEqual(key, KeyCode.UP) or isStringEqual(key, KeyCode.BACK)
            focusPill(0)
            return true
        end if
        if isStringEqual(key, KeyCode.DOWN)
            unfocusDash()
            showDash(false)
            m.homeRows.setfocus(true)
            setLastFocus(m.homeRows)
            return true
        end if
        if isStringEqual(key, KeyCode.PLAY)
            toggleMusic()
            return true
        end if
        if isStringEqual(key, KeyCode.OK)
            if m.dashIndex = 0
                if isValid(m.heroItem) then m.homeRows.quickPlayNode = m.heroItem
            else if m.dashIndex = 1
                m.pillIndex = 3
                enterPill()
            else
                m.global.sceneManager.callFunc("userMessage", "Requests", "Requests connect to Overseerr in a later Hearth build.")
            end if
            return true
        end if
        return false
    end if

    if m.buttons.isInFocusChain()
        if isStringEqual(key, KeyCode.REPLAY)
            if not audioMiniPlayerIsVisibleInScene() then return true
            unfocusPills()
        end if

        if isStringEqual(key, KeyCode.OK) or isStringEqual(key, KeyCode.DOWN)
            enterPill()
            return true
        end if

        if isStringEqual(key, KeyCode.RIGHT)
            focusPill(m.pillIndex + 1)
            return true
        end if

        if isStringEqual(key, KeyCode.LEFT)
            focusPill(m.pillIndex - 1)
            return true
        end if

        if isStringEqual(key, KeyCode.OPTIONS)
            m.top.getScene().jumpTo = { selectionType: "settings" }
            return true
        end if

        return false
    end if

    ' If the user hit back and is not on the first item of the row,
    ' assume they want to go to the first item of the row.
    ' Otherwise, they are exiting the app.
    if isStringEqual(key, KeyCode.BACK)
        rowItemFocused = chainLookupReturn(m.homeRows, "rowItemFocused", [0, 0])
        if isNumber(rowItemFocused[1])
            if rowItemFocused[1] > 0
                m.homeRows.jumpToRowItem = [rowItemFocused[0], 0]
                return true
            end if
        end if
    end if

    ' Hearth: Back from the rows climbs to the pills (Back there leaves the app)
    if isStringEqual(key, KeyCode.BACK) and m.homeRows.isInFocusChain()
        focusPill(0)
        return true
    end if

    if isStringEqual(key, KeyCode.OPTIONS)
        if m.homeRows.hasFocus()
            focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])
            if not isValidAndNotEmpty(focusedItem) then return false
            if chainLookupReturn(focusedItem, "json.FavoriteViewAll", false) then return true

            ' Skip loading playlists and mylist data for radio stations
            if inArray([ItemType.RADIOSTATION], focusedItem.LookupCI("type"))
                itemID = focusedItem.LookupCI("id")
                if isStringEqual(itemID, "createstation")
                    return false
                end if

                paramData = {
                    id: itemID
                }
                m.global.sceneManager.callFunc("optionDialog", "libraryitem", focusedItem.LookupCI("title") ?? tr("Options"), [], [tr("Delete Radio Station")], paramData)
                return true
            end if


            m.loadMetaDataTask.itemId = focusedItem.LookupCI("id")
            m.loadMetaDataTask.control = TaskControl.RUN
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.UP)
        ' In case the user pressed up rapidly and the focused row wasn't able to update in time
        if m.buttons.opacity < 1
            toggleButtonsVisibility(true)
        end if

        focusDash(0)
        return true
    end if

    return false
end function

sub onMetaDataLoaded()
    data = m.loadMetaDataTask.content[0]

    m.favoritesOptionText = chainLookupReturn(data, "json.UserData.IsFavorite", false) ? tr("Remove From Favorites") : tr("Add To Favorites")

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])

    m.loadItemsTask1.itemId = focusedItem.LookupCI("id")
    m.loadItemsTask1.control = TaskControl.RUN
end sub
