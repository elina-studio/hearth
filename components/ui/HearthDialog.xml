<?xml version="1.0" encoding="utf-8"?>
<!-- Hearth's own menu and message sheet (walk 2, item 14; mockups/walk2/14-menu-sheet.png). It takes the place of
     Roku's StandardMessageDialog everywhere, with the same fields, so a caller only changes how it is shown:
     hShowDialog(d) (source/util.brs) instead of scene.dialog = d.
     buttons: "Label" or "Label: value" (the value is drawn on the right). heads: { "<button index>": "GROUP" }
     puts a group title above that button. Like the Roku dialog, choosing a button does not close it; the caller
     sets close = true. wasClosed fires once, however it closed.
     popup = true (set before showing) is for questions and notices: a centred card, buttons in one row. -->
<component name="HearthDialog" extends="Group">
  <children>
    <Rectangle id="shade" width="1920" height="1080" color="0x0B0E09B8" />
    <Poster id="panelRing" uri="pkg:/images/w/panel.9.png" visible="false" blendColor="0xE0B34A66" />
    <Poster id="panel" uri="pkg:/images/w/panel.9.png" translation="[1168, 28]" width="684" height="1024" blendColor="0x141A11FF" />
    <Label id="title" translation="[1220, 68]" width="580" maxLines="2" wrap="true" lineSpacing="0" color="0xEDE6CAFF" />
    <Label id="msg" translation="[1220, 130]" width="580" maxLines="12" wrap="true" lineSpacing="2" color="0xB5AF8CFF" />
    <Rectangle id="rule" translation="[1220, 180]" width="580" height="2" color="0xE0B34A66" />
    <Group id="list" translation="[1206, 200]" />
    <Label id="more" translation="[1220, 952]" width="580" color="0xB5AF8CFF" />
    <Label id="hint" translation="[1220, 990]" width="580" color="0xB5AF8CFF" />
    <Timer id="hold" duration="0.4" repeat="true" />
  </children>
  <interface>
    <field id="title" type="string" />
    <field id="message" type="stringarray" />
    <field id="buttons" type="stringarray" />
    <field id="heads" type="assocarray" />
    <!-- a question or a notice ("Leave Hearth?"): a small card in the middle with its buttons side by side,
         instead of the side sheet that menus use (mockups/leave-popup/leave-popup.png) -->
    <field id="popup" type="boolean" value="false" />
    <field id="buttonFocused" type="integer" value="0" />
    <field id="buttonSelected" type="integer" value="0" alwaysNotify="true" />
    <field id="close" type="boolean" value="false" onChange="onClose" />
    <field id="wasClosed" type="boolean" alwaysNotify="true" />
    <function name="open" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ui/HearthDialog.brs" />
</component>
