<?xml version="1.0" encoding="utf-8"?>
<!-- Bazarr calls for the subtitle finder. The key and address live on the TV (registry "hearth":
     bazarrKey, optional bazarrUrl), never in the repo.
     op "search": args { file, series, season, episode, movie } -> response { Items, ids }
     op "download": args { ids, provider, subtitle, hi, forced } -->
<component name="BazarrTask" extends="Task">
  <interface>
    <field id="op" type="string" />
    <field id="args" type="assocarray" />
    <field id="tag" type="string" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="ok" type="boolean" />
    <field id="error" type="string" />
    <field id="response" type="assocarray" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/subs/BazarrTask.brs" />
</component>
