<?xml version="1.0" encoding="utf-8"?>
<!-- A mood, full screen. OK = sound switch (fire / music / both), Left/Right = next mood, * = sound and sleep timer, Back = leave. -->
<component name="MoodScreen" extends="Group">
  <children>
    <MoodScene id="scene" />
    <AmbientSound id="sound" />
    <!-- plays the mood's footage when the package has it; with no content it still keeps the screensaver off -->
    <Video id="video" width="1920" height="1080" visible="false" enableUI="false" loop="true" disableScreenSaver="true" />
    <!-- shown instantly, hidden once the video is actually playing -->
    <Poster id="still" width="1920" height="1080" loadDisplayMode="scaleToZoom" visible="false" />
    <Rectangle id="dim" width="1920" height="1080" color="0x000000FF" opacity="0" />
    <Label id="cornerClock" translation="[1524, 60]" width="300" horizAlign="right" color="0xEDE6CA99" visible="false" />
    <Timer id="clockTick" duration="20" repeat="true" />
    <Group id="hud" opacity="0">
      <Poster uri="pkg:/images/shade.png" width="1920" height="300" translation="[0, 780]" />
      <Label id="name" translation="[96, 900]" width="1200" color="0xEDE6CAFF" />
      <Label id="state" translation="[96, 968]" width="1200" color="0xE0B34AFF" />
      <Label id="hint" translation="[1000, 976]" width="824" horizAlign="right" color="0xB5AF8CFF" />
      <Label id="credit" translation="[1000, 1030]" width="824" horizAlign="right" color="0xB5AF8C99" />
      <Label id="clock" translation="[1524, 900]" width="300" horizAlign="right" color="0xEDE6CAFF" />
      <!-- the sound switch (OK cycles): Fire / Music / Both -->
      <Group id="mix" translation="[1296, 760]" />
    </Group>
    <Rectangle id="night" width="1920" height="1080" color="0x000000FF" opacity="0" />
    <Animation id="hudIn" duration="0.4" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="hud.opacity" />
    </Animation>
    <Animation id="hudOut" duration="1.2" easeFunction="inQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="hud.opacity" />
    </Animation>
    <Animation id="sleepFade" duration="20" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="night.opacity" />
    </Animation>
    <!-- music modes: the clip's still drifts slowly instead of the video -->
    <Animation id="drift" duration="60" repeat="true" easeFunction="inOutQuad">
      <Vector2DFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[[1.0, 1.0], [1.12, 1.12], [1.0, 1.0]]" fieldToInterp="still.scale" />
      <Vector2DFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[[0, 0], [-40, -18], [0, 0]]" fieldToInterp="still.translation" />
    </Animation>
    <Timer id="hudTimer" duration="5" repeat="false" />
    <Timer id="sleepTimer" repeat="false" />
  </children>
  <interface>
    <field id="mood" type="string" onChange="onMood" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/ambianceData.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/MoodScreen.brs" />
</component>
