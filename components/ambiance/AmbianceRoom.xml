<?xml version="1.0" encoding="utf-8"?>
<!-- Ambiance room (layout C): three tall panels at a time with a peek at each side, gold dividers between,
     number, title and line of text over the top of each picture. Left/Right slides; OK opens the mood
     full screen; Up or Back returns to the pills. -->
<component name="AmbianceRoom" extends="Group">
  <children>
    <Group id="strip" />
    <Group id="dots" />
    <Animation id="slide" duration="0.32" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="slideTo" key="[0.0, 1.0]" fieldToInterp="strip.translation" />
    </Animation>
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/ambianceData.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/AmbianceRoom.brs" />
</component>
