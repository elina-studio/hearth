<?xml version="1.0" encoding="utf-8"?>
<!-- Ambiance room: a row of moods. OK opens one full screen; Up or Back returns to the pills. -->
<component name="AmbianceRoom" extends="Group">
  <children>
    <Label id="title" translation="[96, 20]" width="1600" color="0xEDE6CAFF" text="Set the mood" />
    <CardRow id="row" translation="[96, 110]" title="Moods" cardWidth="300" cardHeight="420" viewWidth="1728" />
    <Label id="note" translation="[96, 760]" width="1300" wrap="true" color="0xB5AF8CFF" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/AmbianceRoom.brs" />
</component>
