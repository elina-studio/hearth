<?xml version="1.0" encoding="utf-8"?>
<!-- Ambiance room: five tall columns edge to edge, split by gold weave rules, titles over the pictures.
     The focused column widens. OK opens the mood full screen; Up or Back returns to the pills. -->
<component name="AmbianceRoom" extends="Group">
  <children>
    <Group id="cols" />
    <Timer id="step" duration="0.033" repeat="true" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/ambianceData.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/AmbianceRoom.brs" />
</component>
