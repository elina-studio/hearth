<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a short hero band that steps through your top 3 Continue items, three cards (Now playing,
     Requests, Set the mood), then Next up and Recently added. Coordinates are relative to the room,
     which sits 150 below the top of the screen. -->
<component name="HomeRoom" extends="Group">
  <children>
    <Group id="content" translation="[0, 16]">
      <!-- a short hero panel on the left half only (build 104); its art stays inside it and fades into the night
           on the left. Tonight has its own panel on the right. -->
      <!-- rough-edged hero panel (whimsy spec 6); the art is cut to the same rough edge with a mask -->
      <Poster uri="pkg:/images/w/panel-hero-716x250.png" translation="[84, -12]" width="740" height="274" />
      <MaskGroup maskUri="pkg:/images/w/panel-716x250.png" maskSize="[740, 274]" maskOffset="[84, -12]">
        <Poster id="heroArt" translation="[96, 0]" width="716" height="250" loadDisplayMode="scaleToZoom" opacity="0.85" />
        <Poster uri="pkg:/images/fade-left.png" translation="[96, 0]" width="716" height="250" />
      </MaskGroup>

      <Label id="greeting" translation="[96, 0]" visible="false" color="0xD9A066FF" />
      <Label id="heroEyebrow" translation="[136, 20]" width="600" color="0xE0B34AFF" />
      <ScrollingLabel id="heroTitle" translation="[136, 48]" maxWidth="680" height="96" repeatCount="-1" scrollSpeed="70" color="0xEDE6CAFF" />
      <Group id="heroProgress" translation="[136, 158]">
        <Rectangle width="300" height="6" color="0xFFFFFF26" />
        <Rectangle id="heroBar" width="0" height="6" color="0xE0B34AFF" />
        <Label id="heroLeft" translation="[320, -17]" height="40" vertAlign="center" color="0xEDE6CAFF" />
      </Group>
      <Group id="buttons" translation="[136, 186]" />

      <!-- which of the 3 Continue items is showing -->
      <Group id="pager" translation="[0, 24]">
        <Poster id="pgLeft" uri="pkg:/images/icons/home-left.png" width="30" height="30" blendColor="0xB5AF8CFF" />
        <Group id="dots" />
        <Poster id="pgRight" uri="pkg:/images/icons/home-right.png" width="30" height="30" blendColor="0xB5AF8CFF" />
        <Label id="pgText" height="30" vertAlign="center" color="0xB5AF8CFF" />
      </Group>


      <!-- Tonight: three picks (a short episode, a film, a playlist) inline with Continue, right of a thin divider -->
      <Group id="tonight" translation="[870, 0]" visible="false">
        <Poster uri="pkg:/images/tile-v2.9.png" blendColor="0x141A11FF" translation="[-26, -12]" width="980" height="274" />
        <Poster uri="pkg:/images/icons/icon-moon.png" translation="[0, 12]" width="28" height="28" blendColor="0xE0B34AFF" />
        <Label id="tnTitle" translation="[42, 6]" height="40" vertAlign="center" color="0xEDE6CAFF" text="Tonight" />
        <Label id="tnNote" translation="[608, 10]" width="300" height="32" vertAlign="center" horizAlign="right" color="0xB5AF8CFF" />
        <Group id="tnCards" translation="[0, 58]" />
      </Group>

      <!-- Now playing -->
      <Group id="musicCard" translation="[96, 276]">
        <Poster uri="pkg:/images/tile-v1.9.png" blendColor="0x141A11F2" width="604" height="230" />
        <Rectangle translation="[28, 26]" width="178" height="178" color="0x2A2620FF" />
        <Poster id="musicArt" translation="[28, 26]" width="178" height="178" loadDisplayMode="scaleToZoom" />
        <Poster uri="pkg:/images/icons/home-note.png" translation="[228, 30]" width="28" height="28" blendColor="0xD9A066FF" />
        <Label id="musicEyebrow" translation="[264, 28]" height="32" vertAlign="center" color="0xD9A066FF" />
        <ScrollingLabel id="musicTitle" translation="[228, 64]" maxWidth="350" height="42" repeatCount="-1" scrollSpeed="50" color="0xEDE6CAFF" />
        <Label id="musicSub" translation="[228, 100]" width="350" maxLines="1" color="0xB5AF8CFF" />
        <Poster id="mSpkIcon" uri="pkg:/images/music/icons/speaker.png" translation="[228, 134]" width="24" height="24" blendColor="0xE0B34AFF" />
        <Label id="mSpk" translation="[260, 130]" width="320" height="32" vertAlign="center" maxLines="1" color="0xE0B34AFF" />
        <Poster id="mRing0" uri="pkg:/images/ring-v1.9.png" blendColor="0xE0B34AFF" translation="[216, 162]" width="56" height="56" visible="false" />
        <Poster id="mRing1" uri="pkg:/images/ring-v2.9.png" blendColor="0xE0B34AFF" translation="[272, 162]" width="56" height="56" visible="false" />
        <Poster id="mRing2" uri="pkg:/images/ring-v3.9.png" blendColor="0xE0B34AFF" translation="[328, 162]" width="56" height="56" visible="false" />
        <Poster id="mRing3" uri="pkg:/images/ring-v4.9.png" blendColor="0xE0B34AFF" translation="[384, 162]" width="56" height="56" visible="false" />
        <Poster id="mRing4" uri="pkg:/images/ring-v5.9.png" blendColor="0xE0B34AFF" translation="[440, 162]" width="56" height="56" visible="false" />
        <Poster id="mPrev" uri="pkg:/images/icons/home-prev.png" translation="[228, 174]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mToggle" uri="pkg:/images/icons/home-play.png" translation="[284, 174]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mNext" uri="pkg:/images/icons/home-next.png" translation="[340, 174]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mLike" uri="pkg:/images/music/icons/heart.png" translation="[396, 174]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mRadio" uri="pkg:/images/music/icons/radio.png" translation="[452, 174]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Rectangle translation="[228, 218]" width="352" height="6" color="0xFFFFFF1F" />
        <Rectangle id="musicBar" translation="[228, 218]" width="0" height="6" color="0xA3A35AFF" />
        <Poster id="mRing5" uri="pkg:/images/ring-v6.9.png" blendColor="0xE0B34AFF" translation="[212, 122]" width="380" height="48" visible="false" />
        <Group id="spkPanel" translation="[212, 12]" visible="false">
          <Rectangle width="380" height="206" color="0x141A11FF" />
          <Poster uri="pkg:/images/music/icons/speaker.png" translation="[16, 12]" width="24" height="24" blendColor="0xE0B34AFF" />
          <Label id="spkTitle" translation="[48, 8]" height="32" vertAlign="center" color="0xE0B34AFF" text="PLAY ON" />
          <Group id="spkRows" translation="[8, 44]" />
        </Group>
      </Group>

      <!-- Requests -->
      <Group id="reqCard" translation="[730, 276]">
        <Poster uri="pkg:/images/tile-v2.9.png" blendColor="0x141A11F2" width="532" height="230" />
        <Poster uri="pkg:/images/icons/home-down.png" translation="[28, 30]" width="28" height="28" blendColor="0xB5AF8CFF" />
        <Label id="reqEyebrow" translation="[64, 28]" height="32" vertAlign="center" color="0xB5AF8CFF" text="NEWLY DOWNLOADED" />
        <Label id="reqNote" translation="[28, 28]" width="476" height="32" vertAlign="center" horizAlign="right" color="0xA3A35AFF" />
        <Group id="reqLines" translation="[28, 66]" />
        <Label id="reqEmpty" translation="[28, 100]" width="476" horizAlign="center" color="0xB5AF8CFF" />
        <Poster id="reqRing" uri="pkg:/images/ring-v4.9.png" blendColor="0xE0B34AFF" translation="[-10, -10]" width="552" height="250" visible="false" />
      </Group>

      <!-- Set the mood -->
      <Group id="moodCard" translation="[1292, 276]">
        <Poster uri="pkg:/images/tile-v3.9.png" blendColor="0x141A11F2" width="532" height="230" />
        <Poster uri="pkg:/images/icons/home-flame.png" translation="[28, 30]" width="28" height="28" blendColor="0xB5AF8CFF" />
        <Label id="moodEyebrow" translation="[64, 28]" height="32" vertAlign="center" color="0xB5AF8CFF" text="SET THE MOOD" />
        <Group id="moodTiles" translation="[28, 70]" />
      </Group>

      <CardRow id="nextUp" translation="[96, 540]" title="Next up" icon="pkg:/images/icons/home-play.png" countNoun="to watch" seed="0" />
      <CardRow id="latest" translation="[96, 880]" title="Recently added" icon="pkg:/images/icons/home-flame.png" countNoun="new" seed="1" />
      <CardRow id="musicRow" translation="[96, 1220]" title="Music · new albums" icon="pkg:/images/icons/home-note.png" countNoun="albums" seed="2" cardWidth="240" cardHeight="240" />
      <CardRow id="reqRow" translation="[96, 1560]" title="Newly downloaded" icon="pkg:/images/icons/home-down.png" countNoun="new" seed="3" cardWidth="200" cardHeight="300" />
      <CardRow id="photoRow" translation="[96, 1900]" title="Photos · lately" icon="pkg:/images/icons/home-cal.png" countNoun="photos" seed="0" />
    </Group>
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="content.translation" />
    </Animation>
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- set once the first data has arrived (or there is nothing to load); the launch warm-up waits for it -->
    <field id="ready" type="boolean" value="false" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/reqdata.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/HomeRoom.brs" />
</component>
