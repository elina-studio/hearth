<?xml version="1.0" encoding="utf-8"?>
<!-- Home: a short hero band that steps through your top 3 Continue items, three cards (Now playing,
     Requests, Set the mood), then Next up and Recently added. Coordinates are relative to the room,
     which sits 150 below the top of the screen. -->
<component name="HomeRoom" extends="Group">
  <children>
    <Group id="content">
      <!-- a short hero band (about a quarter of the screen); its art fades into the night on the left -->
      <Rectangle translation="[96, 0]" width="1728" height="250" color="0x141A11FF" />
      <Poster id="heroArt" translation="[96, 0]" width="1728" height="250" loadDisplayMode="scaleToZoom" />
      <Poster uri="pkg:/images/fade-left.png" translation="[96, 0]" width="1150" height="250" />

      <Label id="greeting" translation="[96, 0]" visible="false" color="0xD9A066FF" />
      <Label id="heroEyebrow" translation="[136, 20]" width="1300" color="0xE0B34AFF" />
      <Label id="heroTitle" translation="[136, 48]" width="1300" maxLines="1" color="0xEDE6CAFF" />
      <Group id="heroProgress" translation="[136, 136]">
        <Rectangle width="300" height="6" color="0xFFFFFF26" />
        <Rectangle id="heroBar" width="0" height="6" color="0xE0B34AFF" />
        <Label id="heroLeft" translation="[320, -17]" height="40" vertAlign="center" color="0xEDE6CAFF" />
      </Group>
      <Group id="buttons" translation="[136, 164]" />

      <!-- which of the 3 Continue items is showing -->
      <Group id="pager" translation="[0, 206]">
        <Poster id="pgLeft" uri="pkg:/images/icons/home-left.png" width="30" height="30" blendColor="0xB5AF8CFF" />
        <Group id="dots" />
        <Poster id="pgRight" uri="pkg:/images/icons/home-right.png" width="30" height="30" blendColor="0xB5AF8CFF" />
        <Label id="pgText" height="30" vertAlign="center" color="0xB5AF8CFF" />
      </Group>

      <!-- Now playing -->
      <Group id="musicCard" translation="[96, 276]">
        <Poster uri="pkg:/images/tile.9.png" blendColor="0x141A11F2" width="604" height="230" />
        <Rectangle translation="[28, 26]" width="178" height="178" color="0x2A2620FF" />
        <Poster id="musicArt" translation="[28, 26]" width="178" height="178" loadDisplayMode="scaleToZoom" />
        <Poster uri="pkg:/images/icons/home-note.png" translation="[228, 30]" width="28" height="28" blendColor="0xD9A066FF" />
        <Label id="musicEyebrow" translation="[264, 28]" height="32" vertAlign="center" color="0xD9A066FF" />
        <Label id="musicTitle" translation="[228, 64]" width="350" maxLines="1" color="0xEDE6CAFF" />
        <Label id="musicSub" translation="[228, 108]" width="350" maxLines="1" color="0xB5AF8CFF" />
        <Poster id="mRing0" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[216, 158]" width="56" height="56" visible="false" />
        <Poster id="mRing1" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[272, 158]" width="56" height="56" visible="false" />
        <Poster id="mRing2" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[328, 158]" width="56" height="56" visible="false" />
        <Poster id="mPrev" uri="pkg:/images/icons/home-prev.png" translation="[228, 170]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mToggle" uri="pkg:/images/icons/home-play.png" translation="[284, 170]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Poster id="mNext" uri="pkg:/images/icons/home-next.png" translation="[340, 170]" width="32" height="32" blendColor="0xEDE6CAFF" />
        <Rectangle translation="[396, 183]" width="180" height="6" color="0xFFFFFF1F" />
        <Rectangle id="musicBar" translation="[396, 183]" width="0" height="6" color="0xA3A35AFF" />
      </Group>

      <!-- Requests -->
      <Group id="reqCard" translation="[730, 276]">
        <Poster uri="pkg:/images/tile.9.png" blendColor="0x141A11F2" width="532" height="230" />
        <Poster uri="pkg:/images/icons/home-down.png" translation="[28, 30]" width="28" height="28" blendColor="0xB5AF8CFF" />
        <Label id="reqEyebrow" translation="[64, 28]" height="32" vertAlign="center" color="0xB5AF8CFF" text="REQUESTS" />
        <Group id="reqLines" translation="[28, 70]" />
        <Label id="reqFoot" translation="[28, 184]" width="476" color="0xE0B34AFF" />
        <Poster id="reqRing" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[-10, -10]" width="552" height="250" visible="false" />
      </Group>

      <!-- Set the mood -->
      <Group id="moodCard" translation="[1292, 276]">
        <Poster uri="pkg:/images/tile.9.png" blendColor="0x141A11F2" width="532" height="230" />
        <Poster uri="pkg:/images/icons/home-flame.png" translation="[28, 30]" width="28" height="28" blendColor="0xB5AF8CFF" />
        <Label id="moodEyebrow" translation="[64, 28]" height="32" vertAlign="center" color="0xB5AF8CFF" text="SET THE MOOD" />
        <Group id="moodTiles" translation="[28, 70]" />
      </Group>

      <CardRow id="nextUp" translation="[96, 540]" title="Next up" />
      <CardRow id="latest" translation="[96, 880]" title="Recently added" />
      <CardRow id="musicRow" translation="[96, 1220]" title="Music · new albums" cardWidth="240" cardHeight="240" />
      <CardRow id="reqRow" translation="[96, 1560]" title="Requests" cardWidth="200" cardHeight="300" />
      <CardRow id="photoRow" translation="[96, 1900]" title="Photos · lately" />
    </Group>
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="content.translation" />
    </Animation>
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/requests/reqdata.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/HomeRoom.brs" />
</component>
