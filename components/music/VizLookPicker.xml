<?xml version="1.0" encoding="utf-8"?>
<!-- Visualizer look picker (MusicView, * > Choose a look). Eight across, four down: Shuffle first, then every look (rows scroll).
     OK uses the focused one (Shuffle plays the hearted or all looks, per the Play setting), Play/Pause hearts or unhearts a look,
     Back closes. MusicView keeps focus and forwards keys to handleKey; chosen reports the pick ("close" when closed). -->
<component name="VizLookPicker" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E09F2" />
    <Label id="kicker" translation="[132, 64]" width="900" color="0xD9A066FF" text="VISUALIZER LOOK" />
    <Label id="title" translation="[132, 104]" width="1300" maxLines="1" color="0xEDE6CAFF" />
    <Label id="sub" translation="[132, 184]" width="1500" maxLines="1" color="0xB5AF8CFF" />
    <Group id="clip" translation="[132, 262]">
      <Group id="grid" />
    </Group>
    <Label id="hint" translation="[132, 992]" width="1656" horizAlign="center" color="0xB5AF8CFF"
      text="OK uses this look  ·  Play/Pause hearts it  ·  Back closes" />
  </children>
  <interface>
    <field id="chosen" type="string" alwaysNotify="true" />
    <function name="open" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/vizlooks.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/VizLookPicker.brs" />
</component>
