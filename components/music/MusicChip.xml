<?xml version="1.0" encoding="utf-8"?>
<!-- A Music control: an icon, optionally followed by a word. Rough-edged like Hearth's other buttons (no moss in Music).
     States: idle (dim fill), on (gold ring and gold icon, e.g. Shuffle on), focused (gold fill). -->
<component name="MusicChip" extends="Group">
  <children>
    <!-- rough hand-cut edges (whimsy spec 6): 9-patches with 12px padding, so they sit at -12,-12 and are 24 bigger -->
    <Poster id="base" translation="[-12, -12]" blendColor="0xFFFFFF14" />
    <Poster id="fill" translation="[-12, -12]" blendColor="0xE0B34A80" visible="false" />
    <Poster id="ring" translation="[-12, -12]" blendColor="0xE0B34AFF" visible="false" />
    <Poster id="icon" width="34" height="34" />
    <Label id="label" vertAlign="center" />
    <Label id="badge" vertAlign="center" />
  </children>
  <interface>
    <field id="icon" type="string" onChange="update" />
    <field id="text" type="string" onChange="update" />
    <field id="name" type="string" />
    <field id="badge" type="string" onChange="update" />
    <field id="big" type="boolean" value="false" onChange="update" />
    <field id="focused" type="boolean" value="false" onChange="update" />
    <field id="on" type="boolean" value="false" onChange="update" />
    <field id="width" type="integer" value="0" />
    <field id="height" type="integer" value="64" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicChip.brs" />
</component>
