<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen music: mode "cover" (big album art), "milk" (MilkDrop, rendered for each song) or "hearth" (the fire, with
     fire + music / fire only / music only). The now-playing strip shows on any key and fades after a few seconds. -->
<component name="MusicView" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E09FF" />

    <Group id="cover" visible="false">
      <Poster id="coverBlur" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.45" />
      <Rectangle width="1920" height="1080" color="0x0B0E0966" />
      <Rectangle id="coverBg" translation="[660, 110]" width="600" height="600" color="0x1D2418FF" />
      <Poster id="coverArt" translation="[660, 110]" width="600" height="600" loadDisplayMode="scaleToFit" />
      <Label id="coverTitle" translation="[160, 750]" width="1600" horizAlign="center" maxLines="1" color="0xEDE6CAFF" />
      <Label id="coverSub" translation="[160, 822]" width="1600" horizAlign="center" maxLines="1" color="0xB5AF8CFF" />
      <Group translation="[660, 880]">
        <Poster uri="pkg:/images/w/progress-track.9.png" width="600" height="12" />
        <Group id="coverClip" translation="[1, 1]" clippingRect="[0, 0, 0, 10]">
          <Poster uri="pkg:/images/w/progress-fill-body.png" width="512" height="10" />
        </Group>
        <Poster id="coverTip" uri="pkg:/images/w/progress-fill-tip.png" width="12" height="10" visible="false" />
      </Group>
    </Group>

    <Group id="milk" visible="false">
      <!-- the song's cover, softly, until the MilkDrop stream starts (and if it can't) -->
      <Poster id="vizBack" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.35" />
      <Rectangle width="1920" height="1080" color="0x0B0E0999" />
      <Label id="vizNote" translation="[260, 420]" width="1400" horizAlign="center" wrap="true" lineSpacing="2" color="0xB5AF8CFF" />
      <!-- MilkDrop for this song, with the song in the same stream (MusicPlayer mixplay.brs) -->
      <Video id="vizVideo" width="1920" height="1080" enableUI="false" disableScreenSaver="true" />
      <Group id="lookTag" opacity="0">
        <Rectangle id="lookTagBg" translation="[80, 50]" width="560" height="64" color="0x0B0E09B3" />
        <Label id="presetName" translation="[104, 62]" width="900" color="0xEDE6CAFF" />
      </Group>
    </Group>

    <Group id="hearth" visible="false">
      <Group id="moodHolder" />
      <!-- why the fire is not moving, when the joined stream fails (walk 2, item 28) -->
      <Group id="fireNote" visible="false">
        <Rectangle id="fireNoteBg" translation="[80, 50]" width="900" height="64" color="0x0B0E09CC" />
        <Label id="fireNoteText" translation="[104, 50]" height="64" vertAlign="center" width="1500" maxLines="1" color="0xEDE6CAFF" />
      </Group>
      <Label id="noFire" translation="[160, 480]" width="1600" horizAlign="center" wrap="true" lineSpacing="2" color="0xB5AF8CFF" visible="false" />
    </Group>

    <LyricsPanel id="lyrics" translation="[1060, 150]" />

    <Group id="strip" opacity="0">
      <Rectangle translation="[0, 860]" width="1920" height="220" color="0x0B0E09D9" />
      <Rectangle translation="[96, 890]" width="150" height="150" color="0x1D2418FF" />
      <Poster id="sArt" translation="[96, 890]" width="150" height="150" loadDisplayMode="scaleToFit" />
      <Label id="sEyebrow" translation="[280, 898]" width="900" color="0xD9A066FF" />
      <Label id="sTitle" translation="[280, 936]" width="1000" maxLines="1" color="0xEDE6CAFF" />
      <Label id="sSub" translation="[280, 990]" width="1000" maxLines="1" color="0xB5AF8CFF" />
      <Label id="sHint" translation="[1220, 912]" width="604" horizAlign="right" wrap="true" lineSpacing="2" color="0xB5AF8CFF" />
      <Label id="sToast" translation="[1220, 1010]" width="604" horizAlign="right" maxLines="1" color="0xE0B34AFF" />
    </Group>

    <Animation id="stripIn" duration="0.25" easeFunction="outQuad">
      <FloatFieldInterpolator id="stripInI" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="strip.opacity" />
    </Animation>
    <Animation id="stripOut" duration="0.8" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="strip.opacity" />
    </Animation>
    <Timer id="stripTimer" duration="4" repeat="false" />

    <Animation id="tagIn" duration="0.25" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="lookTag.opacity" />
    </Animation>
    <Animation id="tagOut" duration="0.8" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="lookTag.opacity" />
    </Animation>
    <Timer id="tagTimer" duration="3" repeat="false" />
    <!-- the look picker (* > Visualizer look), drawn over everything -->
    <VizLookPicker id="picker" visible="false" />
  </children>
  <interface>
    <field id="mode" type="string" onChange="onMode" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/ambiance/ambianceData.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/nas.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/vizlooks.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicView.brs" />
</component>
