<?xml version="1.0" encoding="utf-8"?>
<!-- The one music player for the whole app (m.global.music). It lives on the scene, so music keeps
     playing in every room. Send commands with music.command = { cmd: ... }; read state, track, position. -->
<component name="MusicPlayer" extends="Group">
  <children>
    <Audio id="audio" notificationInterval="1" />
    <Timer id="report" duration="10" repeat="true" />
    <Timer id="castTimer" repeat="false" />
    <Timer id="castClock" duration="1" repeat="true" />
    <Timer id="castPoll" repeat="false" />
    <Timer id="castAlign" duration="0.35" repeat="false" />
  </children>
  <interface>
    <field id="command" type="assocarray" alwaysNotify="true" onChange="onCommand" />
    <field id="state" type="string" value="none" />
    <field id="track" type="assocarray" />
    <field id="queue" type="array" />
    <field id="index" type="integer" value="0" />
    <field id="position" type="float" />
    <field id="duration" type="float" />
    <field id="shuffle" type="boolean" value="false" />
    <field id="repeat" type="string" value="off" />
    <field id="busy" type="boolean" value="false" />
    <field id="section" type="string" />
    <field id="sectionName" type="string" />
    <field id="libraries" type="array" />
    <field id="message" type="string" alwaysNotify="true" />
    <!-- other rooms (cast.brs) -->
    <field id="rooms" type="array" />
    <field id="castCount" type="integer" value="0" />
    <field id="castDelay" type="float" value="1.5" />
    <!-- Last.fm (lastfm.brs): off | idle | now | counted | queued -->
    <!-- Plex rating of this song: "like" (8 to 10 stars), "dislike" (up to 2), or "" -->
    <field id="liked" type="string" value="" />
    <field id="lfmState" type="string" value="off" />
    <!-- a lyrics panel is open on this screen / found lyrics for this song (LyricsPanel) -->
    <field id="lyricsActive" type="boolean" value="false" />
    <field id="lyricsFound" type="boolean" value="false" />
    <!-- Radio (radio.brs): false | true, and its seed name -->
    <field id="radioOn" type="boolean" value="false" />
    <field id="radioName" type="string" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/source/photos.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/cast.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/nas.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/lastfm.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/radio.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/queue.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicPlayer.brs" />
</component>
