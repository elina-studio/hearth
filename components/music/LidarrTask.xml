<?xml version="1.0" encoding="utf-8"?>
<!-- One call to Lidarr's API (v1). The key comes from the TV registry ("hearth" / "lidarrKey"). -->
<component name="LidarrTask" extends="Task">
  <interface>
    <field id="method" type="string" value="GET" />
    <field id="path" type="string" />
    <field id="query" type="assocarray" />
    <field id="bodyText" type="string" />
    <field id="tag" type="string" />
    <field id="timeout" type="integer" value="20000" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="ok" type="boolean" />
    <field id="response" type="assocarray" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/keys.brs" />
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/LidarrTask.brs" />
</component>
