<?xml version="1.0" encoding="utf-8"?>
<!-- Music: now playing with its controls, then shelves from Plex (recently played, added, playlists, albums). -->
<component name="MusicRoom" extends="Group">
  <children>
    <!-- clip so shelves scrolled up never show through the pill bar -->
    <Group clippingRect="[0, 0, 1920, 930]">
    <Group id="content">
      <Rectangle id="artBg" translation="[96, 10]" width="300" height="300" color="0x1D2418FF" />
      <Poster id="art" translation="[96, 10]" width="300" height="300" loadDisplayMode="scaleToFit" />
      <Group translation="[440, 20]">
        <Label id="eyebrow" color="0xD9A066FF" />
        <Label id="title" translation="[0, 40]" width="1380" maxLines="1" color="0xEDE6CAFF" />
        <Label id="sub" translation="[0, 124]" width="1380" maxLines="1" color="0xB5AF8CFF" />
        <Rectangle id="track" translation="[0, 190]" width="900" height="8" color="0xFFFFFF1A" />
        <Rectangle id="fill" translation="[0, 190]" width="0" height="8" color="0xE0B34AFF" />
        <Label id="time" translation="[0, 210]" width="900" color="0xB5AF8CFF" />
      </Group>
      <LayoutGroup id="chips" translation="[96, 372]" layoutDirection="horiz" itemSpacings="[12]" vertAlignment="center" />
      <Label id="chipName" translation="[96, 424]" width="900" color="0xB5AF8CFF" />
      <Label id="empty" translation="[96, 490]" width="1600" wrap="true" color="0xB5AF8CFF" />
      <Group id="shelves" translation="[0, 460]" />
    </Group>
    </Group>
    <Label id="toast" translation="[96, 860]" width="1728" color="0xE0B34AFF" />
    <Timer id="toastTimer" duration="4" repeat="false" />
    <Timer id="buildTimer" duration="6" repeat="false" />
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="content.translation" />
    </Animation>
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicRoom.brs" />
</component>
