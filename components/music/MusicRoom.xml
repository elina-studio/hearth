<?xml version="1.0" encoding="utf-8"?>
<!-- Music, layout B: what's playing on the left (with a Big view button), the library on the right.
     Tabs (plain words, gold underline): For you (shelves), Artists and Albums (grids with an A to Z letter row),
     Playlists, New (newly downloaded: the newest album in a spotlight, the rest as tiles), then Request. -->
<component name="MusicRoom" extends="Group">
  <children>
    <MusicNowPanel id="panel" />
    <Group id="tabs" translation="[690, 40]" />
    <Group id="letters" translation="[690, 112]" visible="false">
      <Poster uri="pkg:/images/w/panel-v3.9.png" translation="[-12, -12]" width="1174" height="82" blendColor="0x141A11FF" />
    </Group>
    <Label id="heading" translation="[690, 190]" width="1150" color="0xD9A066FF" />
    <Group clippingRect="[660, 112, 1260, 818]">
      <Group id="shelves" translation="[690, 132]" />
      <MusicGrid id="grid" translation="[690, 240]" visible="false" />
    </Group>
    <Group id="spot" translation="[690, 132]" visible="false">
      <Poster uri="pkg:/images/w/panel-v5.9.png" translation="[-12, -12]" width="1174" height="276" blendColor="0x141A11FF" />
      <Poster uri="pkg:/images/w/panel-v2.9.png" translation="[10, 10]" width="232" height="232" blendColor="0x1D2418FF" />
      <Poster id="spotArt" translation="[22, 22]" width="208" height="208" loadDisplayMode="scaleToZoom" />
      <Label id="spotEyebrow" translation="[256, 28]" width="860" color="0xD9A066FF" />
      <Label id="spotTitle" translation="[256, 60]" width="860" maxLines="1" color="0xEDE6CAFF" />
      <Label id="spotSub" translation="[256, 124]" width="860" maxLines="1" color="0xB5AF8CFF" />
      <Group id="spotChips" translation="[256, 166]" />
    </Group>
    <QueueSheet id="queue" translation="[1010, 150]" visible="false" />
    <Label id="empty" translation="[690, 160]" width="1150" wrap="true" color="0xB5AF8CFF" />
    <Label id="toast" translation="[690, 880]" width="1150" color="0xE0B34AFF" />
    <Timer id="toastTimer" duration="4" repeat="false" />
    <Timer id="buildTimer" duration="6" repeat="false" />
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="shelves.translation" />
    </Animation>
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicRoom.brs" />
</component>
