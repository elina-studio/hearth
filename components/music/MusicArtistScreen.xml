<?xml version="1.0" encoding="utf-8"?>
<!-- An artist (layout B2): slim header, albums down the left, the chosen album's songs in two columns on the right.
     Up/Down picks an album, Right goes into its songs, OK on a song plays the album from there. -->
<component name="MusicArtistScreen" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E09FF" />
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.18" />
    <Rectangle translation="[96, 44]" width="120" height="120" color="0x1D2418FF" />
    <Poster id="art" translation="[96, 44]" width="120" height="120" loadDisplayMode="scaleToZoom" />
    <Poster translation="[96, 44]" width="120" height="120" uri="pkg:/images/music/round-mask.png" />
    <Label id="name" translation="[244, 50]" width="760" maxLines="1" color="0xEDE6CAFF" />
    <Label id="sub" translation="[244, 126]" width="760" maxLines="1" color="0xB5AF8CFF" />
    <Group id="buttons" translation="[0, 72]" />
    <!-- section header (whimsy spec): Fell italic title with its own twig -->
    <Poster id="albTwig" uri="pkg:/images/w/twig-420-s5.png" translation="[210, 156]" width="460" height="120" />
    <Label id="albHead" translation="[96, 196]" width="200" color="0xEDE6CAFF" text="Albums" />
    <Group clippingRect="[40, 250, 640, 700]">
      <Group id="albums" translation="[96, 270]" />
    </Group>
    <Group id="pane" translation="[680, 230]">
      <Rectangle width="150" height="150" color="0x1D2418FF" />
      <Poster id="cover" width="150" height="150" loadDisplayMode="scaleToZoom" />
      <Label id="aTitle" translation="[180, 26]" width="600" maxLines="1" color="0xEDE6CAFF" />
      <Label id="aSub" translation="[180, 88]" width="600" maxLines="1" color="0xB5AF8CFF" />
      <Group id="aButtons" translation="[0, 43]" />
      <Rectangle id="divider" translation="[572, 180]" width="2" height="580" color="0xD9A06622" />
      <Group id="songs" translation="[0, 180]" />
      <Label id="page" translation="[0, 636]" width="1144" horizAlign="right" color="0xB5AF8CFF" />
    </Group>
    <MusicNowPanel id="bar" layout="bar" translation="[0, 950]" />
    <Label id="toast" translation="[680, 900]" width="1144" color="0xE0B34AFF" />
    <Timer id="toastTimer" duration="4" repeat="false" />
  </children>
  <interface>
    <field id="artistId" type="string" />
    <field id="openAlbumId" type="string" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
    <function name="load" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicArtistScreen.brs" />
</component>
