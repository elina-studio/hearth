<?xml version="1.0" encoding="utf-8"?>
<!-- Big view: just the song, large, over its own blurred colours, with what's up next.
     The Library button (or Back) returns to the Music room. -->
<component name="MusicBigView" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E09FF" />
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.4" />
    <Poster width="1920" height="1080" uri="pkg:/images/shade.png" opacity="0.6" />
    <MusicNowPanel id="panel" layout="big" active="true" />
    <Label id="nextTitle" translation="[96, 808]" color="0xB5AF8CFF" text="Up next" />
    <Poster id="nextRule" uri="pkg:/images/w/twig-1580-s5.png" translation="[236, 770]" width="1620" height="120" />
    <Group id="next" translation="[96, 870]" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/MusicBigView.brs" />
</component>
