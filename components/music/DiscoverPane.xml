<?xml version="1.0" encoding="utf-8"?>
<!-- Music > Discover (mockups/music/discover-v2). Four chips: Artists you love, Recommended, New releases, Missing.
     Artist views: a list of artists on the left (8 rows, with a count), the focused artist on the right with its
     albums as a grid of covers, the missing ones first and the ones you own dimmed and marked IN LIBRARY.
     Everything comes from the NAS helper (tools/remote/discover.py + shelf.py), which reads Lidarr, Plex and Last.fm
     and serves the pictures. Pane is 1150 wide; screen position = pane position + (690, 242). -->
<component name="DiscoverPane" extends="Group">
  <children>
    <Group id="chips" translation="[0, 0]" />
    <Group id="list" translation="[8, 96]" />
    <Group id="detail" translation="[500, 96]" visible="false">
      <Label id="kick" translation="[0, 0]" width="650" maxLines="1" color="0xE0B34AFF" />
      <ScrollingLabel id="title" translation="[0, 22]" maxWidth="650" height="60" repeatCount="-1" scrollSpeed="60" color="0xEDE6CAFF" />
      <Label id="meta" translation="[0, 82]" width="650" maxLines="1" color="0xB5AF8CFF" />
      <Group id="btns" translation="[0, 128]" />
      <Group id="grid" translation="[0, 216]" />
      <Label id="gridNote" translation="[0, 226]" width="620" wrap="true" color="0xB5AF8CFF" />
    </Group>
    <Group id="rel" translation="[0, 96]" />
    <Label id="note" translation="[8, 104]" width="1100" wrap="true" color="0xB5AF8CFF" />
    <Label id="count" translation="[8, 786]" width="640" maxLines="1" color="0xB5AF8CFF" />
    <Label id="toast" translation="[8, 784]" width="700" maxLines="1" color="0xE0B34AFF" />
    <KeyHints id="hints" translation="[1150, 776]" visible="false" />
    <Timer id="toastTimer" duration="5" repeat="false" />
    <Timer id="recheck" duration="12" repeat="false" />
    <Timer id="pvTimer" duration="0.35" repeat="false" />
  </children>
  <interface>
    <field id="active" type="boolean" value="false" onChange="paint" />
    <field id="known" type="array" />
    <!-- Plex artists: lower-case name to round photo URL ("" when Plex has no photo) -->
    <field id="owned" type="assocarray" onChange="onOwned" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="load" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/nas.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/DiscoverPane.brs" />
</component>
