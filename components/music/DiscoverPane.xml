<?xml version="1.0" encoding="utf-8"?>
<!-- Music > Discover (mockup C2). Two chips, "Artists you love" and "Recommended", a list of artists on the left and the
     focused artist on the right. Lists come from the NAS helper (Last.fm: tools/remote/discover.py). Getting albums opens
     the existing Request screen on that artist, so requesting works exactly as it does everywhere else. -->
<component name="DiscoverPane" extends="Group">
  <children>
    <Group id="chips" translation="[0, 0]" />
    <Group id="list" translation="[8, 82]" />
    <Rectangle id="listClip" visible="false" />
    <Group id="detail" translation="[500, 0]" visible="false">
      <Label id="kick" translation="[0, 6]" width="660" maxLines="1" color="0xE0B34AFF" />
      <Label id="title" translation="[0, 38]" width="660" maxLines="1" color="0xEDE6CAFF" />
      <Label id="meta" translation="[0, 108]" width="660" maxLines="1" color="0xB5AF8CFF" />
      <Group id="btns" translation="[0, 160]" />
      <Group id="albums" translation="[0, 250]" />
    </Group>
    <Label id="note" translation="[8, 90]" width="1100" wrap="true" color="0xB5AF8CFF" />
    <Label id="toast" translation="[0, 700]" width="1150" color="0xE0B34AFF" />
    <Timer id="toastTimer" duration="4" repeat="false" />
    <Timer id="pvTimer" duration="0.35" repeat="false" />
  </children>
  <interface>
    <field id="active" type="boolean" value="false" onChange="paint" />
    <field id="known" type="array" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="load" />
    <function name="handleKey" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/nas.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/DiscoverPane.brs" />
</component>
