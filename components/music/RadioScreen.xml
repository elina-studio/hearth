<?xml version="1.0" encoding="utf-8"?>
<!-- Start a radio: pick what it should sound like, set Variety, choose whether to skip this week's songs, then Start.
     Rows: tiles (Left/Right pick, OK chooses), Variety (Left/Right), Skip-this-week toggle (OK), buttons.
     The engine is radio.brs inside MusicPlayer; this screen only sends radioStart. -->
<component name="RadioScreen" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E09FF" />
    <Poster translation="[248, 148]" width="1424" height="760" uri="pkg:/images/w/panel-v3.9.png" blendColor="0x141A11FF" />
    <Label id="title" translation="[304, 190]" color="0xEDE6CAFF" text="Start a radio" />
    <Label id="sub" translation="[304, 262]" color="0xB5AF8CFF" text="Endless songs from your own library that sound like..." />
    <Group id="tiles" translation="[304, 330]" />
    <Group id="vrow" translation="[304, 600]" />
    <Group id="skip" translation="[304, 700]" />
    <Group id="btns" translation="[304, 790]" />
    <Label id="note" translation="[304, 868]" width="1300" color="0xE0B34AFF" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/plex.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/musicui.brs" />
  <script type="text/brightscript" uri="pkg:/components/music/RadioScreen.brs" />
</component>
