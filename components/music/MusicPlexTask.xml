<?xml version="1.0" encoding="utf-8"?>
<!-- One HTTP call to the Plex server. JSON comes back parsed in response. -->
<component name="MusicPlexTask" extends="Task">
  <interface>
    <field id="method" type="string" value="GET" />
    <field id="url" type="string" />
    <field id="query" type="assocarray" />
    <field id="tag" type="string" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="ok" type="boolean" />
    <field id="response" type="assocarray" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/music/MusicPlexTask.brs" />
</component>
