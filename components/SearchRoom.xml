<?xml version="1.0" encoding="utf-8"?>
<!-- Search: a Hearth keyboard (letter grid with suggestions) on the left; matches on the right as you type. -->
<component name="SearchRoom" extends="Group">
  <children>
    <Label id="eyebrow" translation="[96, 10]" color="0xD9A066FF" text="SEARCH" />
    <HearthKeyboard id="kb" translation="[96, 50]" placeholder="Type a title" phoneHint="false" />

    <Label id="resultsLabel" translation="[760, 10]" width="1064" color="0xD9A066FF" />
    <Label id="hint" translation="[760, 70]" width="1000" wrap="true" lineSpacing="2" color="0xB5AF8CFF" />
    <Group id="viewport" translation="[760, 70]">
      <Group id="list" />
    </Group>
    <!-- before anything is typed: the phone shortcut as a card to scan (walk 2, item 29). The code is a picture made
         at build time for the NAS helper's address; with any other address saved the card shows the address alone. -->
    <Group id="phoneCard" translation="[760, 150]" visible="false">
      <Poster uri="pkg:/images/w/panel.9.png" translation="[-12, -12]" width="824" height="254" blendColor="0x141A11FF" />
      <Rectangle id="qrBack" translation="[22, 18]" width="194" height="194" color="0xEDE6CAFF" />
      <Poster id="qr" uri="pkg:/images/phone-qr.png" translation="[24, 20]" width="190" height="190" />
      <Group id="phoneWords" translation="[246, 0]">
        <Label id="pcKicker" translation="[0, 30]" color="0xE0B34AFF" text="Faster on your phone" />
        <Label id="pcTitle" translation="[0, 74]" color="0xEDE6CAFF" text="Point your camera here" />
        <Label id="pcLine1" translation="[0, 126]" width="540" color="0xB5AF8CFF" text="Type or speak, and it lands in this box." />
        <Label id="pcLine2" translation="[0, 160]" width="540" color="0xEDE6CAFF" />
      </Group>
    </Group>
    <!-- shown only while focus is in the Recent list: OK searches again, * removes the search -->
    <KeyHints id="recentHints" translation="[760, 868]" visible="false" />
    <Timer id="debounce" duration="0.35" repeat="false" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/SearchRoom.brs" />
</component>
