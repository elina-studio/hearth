<?xml version="1.0" encoding="utf-8"?>
<!-- Details B: poster on the left, no backdrop. Eyebrow, title, meta, overview, one row of buttons
     (Play / Subtitles / Mark watched) and a cast line beside it; episodes or more like this below. -->
<component name="DetailsScreen" extends="Group">
  <children>
    <Group id="content">
      <Rectangle translation="[96, 40]" width="340" height="510" color="0x2A2620FF" />
      <Poster id="backdrop" translation="[96, 40]" width="340" height="510" loadDisplayMode="scaleToZoom" />
      <Group translation="[480, 50]">
        <Label id="eyebrow" color="0xD9A066FF" />
        <Label id="title" translation="[0, 34]" width="1340" maxLines="1" color="0xEDE6CAFF" />
        <Label id="meta" translation="[0, 132]" width="1300" color="0xB5AF8CFF" />
        <Label id="overview" translation="[0, 178]" width="1240" height="120" wrap="true" maxLines="3" color="0xEDE6CAFF" />
        <Rectangle id="track" translation="[0, 310]" width="420" height="6" color="0xFFFFFF22" visible="false" />
        <Rectangle id="bar" translation="[0, 310]" width="0" height="6" color="0xE0B34AFF" />
        <LayoutGroup id="buttons" translation="[0, 334]" layoutDirection="horiz" itemSpacings="[16]" />
        <Label id="cast" translation="[0, 420]" width="1300" maxLines="1" color="0xB5AF8CFF" />
      </Group>
      <CardRow id="below" translation="[96, 600]" />
    </Group>
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="content.translation" />
    </Animation>
  </children>
  <interface>
    <field id="item" type="assocarray" onChange="load" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/subs.brs" />
  <script type="text/brightscript" uri="pkg:/components/DetailsScreen.brs" />
</component>
