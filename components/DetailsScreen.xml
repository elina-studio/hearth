<?xml version="1.0" encoding="utf-8"?>
<!-- Details, layout A "Ledger" (picked Nov 23; mockups/details/A-ledger.png). Poster on the left; kicker,
     title, meta, ratings and file tags, overview, then an icon action row (Play/Resume, From start, Trailer,
     CC, Audio, Watched, More). Shows add season tabs and a full episode list. Rows below: cast and crew,
     extras, collection, more like this. Everything scrolls as one page. -->
<component name="DetailsScreen" extends="Group">
  <children>
    <Group id="content" translation="[0, 80]">
      <Poster uri="pkg:/images/w/panel.9.png" translation="[88, 48]" width="224" height="324" blendColor="0x1D2418FF" />
      <Poster id="poster" translation="[100, 60]" width="200" height="300" loadDisplayMode="scaleToZoom" />
      <Group translation="[340, 0]">
        <Poster id="backIcon" uri="pkg:/images/icons/d-back.png" translation="[0, 58]" width="24" height="24" blendColor="0xE0B34AFF" />
        <Label id="kicker" translation="[34, 56]" width="1446" maxLines="1" color="0xE0B34AFF" />
        <Label id="title" translation="[0, 88]" width="1480" maxLines="1" color="0xEDE6CAFF" />
        <Label id="meta" translation="[0, 166]" width="1480" maxLines="1" color="0xB5AF8CFF" />
        <LayoutGroup id="tags" translation="[0, 206]" layoutDirection="horiz" vertAlignment="center" itemSpacings="[22]" />
        <Label id="overview" translation="[0, 250]" width="1460" maxLines="2" wrap="true" color="0xEDE6CAFF" />
        <Group id="actions" translation="[0, 334]" />
      </Group>
      <Group id="tabsBox" translation="[100, 440]" visible="false">
        <Group id="tabsClip" clippingRect="[-10, -10, 1320, 94]">
          <Group id="tabs" />
        </Group>
        <LayoutGroup id="chips" translation="[1724, 2]" layoutDirection="horiz" horizAlignment="right" vertAlignment="center" itemSpacings="[14]" />
        <Rectangle translation="[0, 74]" width="1724" height="2" color="0x404B2DFF" />
      </Group>
      <Group id="rows" translation="[100, 0]" />
      <Label id="empty" translation="[100, 520]" width="1700" color="0xB5AF8CFF" visible="false" />
      <Group id="below" translation="[100, 0]" />
    </Group>
    <!-- pinned show header (UX review item 3): once the title scrolls away, the show, season and focused episode
         stay readable just under the rooms bar -->
    <Group id="sticky" visible="false">
      <Rectangle translation="[0, 120]" width="1920" height="92" color="0x0B0E09F5" />
      <Rectangle translation="[100, 210]" width="1720" height="2" color="0x404B2DFF" />
      <Label id="stTitle" translation="[100, 128]" width="1100" maxLines="1" color="0xEDE6CAFF" />
      <Label id="stSub" translation="[100, 172]" width="1720" maxLines="1" color="0xE0B34AFF" />
    </Group>
    <!-- where Back goes and the other keys (picked layout: path as kicker + hint strip, K3) -->
    <Rectangle translation="[0, 1000]" width="1920" height="80" color="0x0B0E09E6" />
    <KeyHints id="hints" translation="[1824, 1018]" />
    <!-- the rooms bar stays on top while the page scrolls under it -->
    <RoomBar id="roomBar" />
    <SideSheet id="sheet" />
    <SubsFinder id="finder" />
    <SubsAuto id="auto" />
    <Timer id="seasonWait" duration="0.35" />
    <Timer id="later" duration="6" />
    <Animation id="scroll" duration="0.22" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="content.translation" />
    </Animation>
  </children>
  <interface>
    <field id="from" type="string" value="" />
    <field id="item" type="assocarray" onChange="load" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/subs.brs" />
  <script type="text/brightscript" uri="pkg:/components/playback.brs" />
  <script type="text/brightscript" uri="pkg:/components/details/tags.brs" />
  <script type="text/brightscript" uri="pkg:/components/details/actions.brs" />
  <script type="text/brightscript" uri="pkg:/components/DetailsScreen.brs" />
</component>
