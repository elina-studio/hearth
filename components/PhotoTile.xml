<?xml version="1.0" encoding="utf-8"?>
<!-- An album on the Photos rail: cover, name, photo count, gold ring when focused. -->
<component name="PhotoTile" extends="Group">
  <children>
    <Poster uri="pkg:/images/tile.9.png" blendColor="0x141A11FF" width="272" height="172" />
    <Poster id="cover" width="272" height="172" loadWidth="272" loadHeight="172" loadDisplayMode="scaleToZoom" />
    <Label id="name" translation="[0, 186]" width="272" height="40" color="0xEDE6CAFF" />
    <Label id="sub" translation="[0, 222]" width="272" color="0xB5AF8CFF" />
    <Poster id="ring" uri="pkg:/images/ring.9.png" blendColor="0xE0B34AFF" translation="[-10, -10]" width="292" height="192" visible="false" />
  </children>
  <interface>
    <field id="title" type="string" alias="name.text" />
    <field id="sub" type="string" alias="sub.text" />
    <field id="image" type="string" alias="cover.uri" />
    <field id="focused" type="boolean" alias="ring.visible" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/PhotoTile.brs" />
</component>
