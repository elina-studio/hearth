<?xml version="1.0" encoding="utf-8"?>
<!-- First launch: server address, then Quick Connect (or password). -->
<component name="SetupScreen" extends="Group">
  <children>
    <Poster uri="pkg:/images/lantern.png" translation="[96, 80]" width="40" height="72" />
    <Label id="step" translation="[160, 96]" color="0xD9A066FF" />
    <Label id="heading" translation="[96, 220]" width="1500" color="0xEDE6CAFF" />
    <Label id="body" translation="[96, 320]" width="1300" wrap="true" color="0xB5AF8CFF" />
    <Label id="big" translation="[96, 470]" width="1500" color="0xE0B34AFF" />
    <LayoutGroup id="buttons" translation="[96, 640]" layoutDirection="horiz" itemSpacings="[16]" />
    <Label id="error" translation="[96, 760]" width="1500" wrap="true" color="0xF0907CFF" />
    <Timer id="poll" duration="3" repeat="true" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/SetupScreen.brs" />
</component>
