<?xml version="1.0" encoding="utf-8"?>
<!-- Photos room, layout C "The window": a live photo fills the room behind three buttons; albums on one rail. -->
<component name="PhotosRoom" extends="Group">
  <children>
    <!-- the room sits 150 px below the top of the screen; the window photo fills the whole screen -->
    <Group id="window" translation="[0, -150]">
      <Poster id="winA" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0" />
      <Poster id="winB" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0" />
      <Poster uri="pkg:/images/photos/room-shade.png" width="1920" height="1080" />
    </Group>
    <Poster id="eyeIcon" uri="pkg:/images/icons/icon-album.png" blendColor="0xE0B34AFF" translation="[96, 182]" width="30" height="30" />
    <Label id="eyebrow" translation="[140, 180]" width="1200" color="0xE0B34AFF" />
    <Label id="title" translation="[96, 214]" width="1700" color="0xEDE6CAFF" />
    <!-- "Saturday 15 June · Lake Tahoe · 12 of 30" for the photo in the window -->
    <Label id="caption" translation="[96, 324]" width="1700" maxLines="1" color="0xB5AF8CFF" />
    <Group id="buttons" translation="[96, 384]" />
    <Label id="albumsLabel" translation="[96, 548]" width="600" color="0xB5AF8CFF" text="ALBUMS" />
    <Group id="albumClip" translation="[86, 584]" clippingRect="[0, 0, 1760, 300]">
      <Group id="albums" translation="[10, 10]" />
    </Group>
    <Label id="note" translation="[96, 600]" width="1728" wrap="true" maxLines="4" color="0xB5AF8CFF" />
    <Animation id="winFade" duration="1.5" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="winIn" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="winA.opacity" />
      <FloatFieldInterpolator id="winOut" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="winB.opacity" />
    </Animation>
    <Animation id="scroll" duration="0.18" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="albums.translation" />
    </Animation>
    <Timer id="winTimer" duration="12" repeat="true" />
  </children>
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- set once the first data has arrived (or there is nothing to load); the launch warm-up waits for it -->
    <field id="ready" type="boolean" value="false" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/photos.brs" />
  <script type="text/brightscript" uri="pkg:/components/PhotosRoom.brs" />
</component>
