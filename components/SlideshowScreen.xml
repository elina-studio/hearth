<?xml version="1.0" encoding="utf-8"?>
<!-- The Window: full-screen photo slideshow of the NAS photos folder (via Plex) with the clock, date and weather. -->
<component name="SlideshowScreen" extends="Group">
  <children>
    <Rectangle width="1920" height="1080" color="0x060805FF" />
    <Group id="layerA" opacity="0">
      <!-- a tiny decode stretched to full screen reads as a blur behind portrait photos -->
      <Poster id="backA" width="1920" height="1080" loadWidth="96" loadHeight="54" loadDisplayMode="scaleToZoom" opacity="0.5" />
      <Group id="panA" scaleRotateCenter="[960, 540]">
        <Poster id="photoA" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToFit" />
        <!-- second portrait photo when two share a slide -->
        <Poster id="photoA2" translation="[960, 0]" width="960" height="1080" loadWidth="640" loadHeight="720" loadDisplayMode="scaleToZoom" visible="false" />
      </Group>
    </Group>
    <Group id="layerB" opacity="0">
      <Poster id="backB" width="1920" height="1080" loadWidth="96" loadHeight="54" loadDisplayMode="scaleToZoom" opacity="0.5" />
      <Group id="panB" scaleRotateCenter="[960, 540]">
        <Poster id="photoB" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToFit" />
        <!-- second portrait photo when two share a slide -->
        <Poster id="photoB2" translation="[960, 0]" width="960" height="1080" loadWidth="640" loadHeight="720" loadDisplayMode="scaleToZoom" visible="false" />
      </Group>
    </Group>
    <!-- fetches the next photo while this one shows, so the change is instant -->
    <Poster id="prefetch" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToFit" opacity="0" />

    <Poster uri="pkg:/images/photo-shade-tr.png" translation="[820, 0]" width="1100" height="640" />
    <Poster uri="pkg:/images/photo-shade-bottom.png" translation="[0, 720]" width="1920" height="360" />
    <!-- the Home clock ("twig and sprig") at a size a little larger than Home: Cinzel time with one firefly, the wild twig,
         the date in Fell, then a gold weather icon and the weather in the book serif. Right-aligned to x 1824. -->
    <Label id="clock" translation="[1700, 48]" color="0xEDE6CAFF" />
    <Poster id="clockFly" uri="pkg:/images/firefly.png" width="20" height="20" translation="[1640, 86]" />
    <Poster uri="pkg:/images/clock/twig.png" translation="[1562, 106]" width="266" height="75" />
    <Label id="date" translation="[1024, 180]" width="800" horizAlign="right" color="0xEDE6CAFF" />
    <Poster id="wxIcon" translation="[1600, 238]" width="28" height="28" blendColor="0xE0B34AFF" visible="false" />
    <Label id="weather" translation="[1650, 232]" height="40" vertAlign="center" color="0xB5AF8CFF" />
    <Group id="captionGroup">
      <Label id="album" translation="[96, 930]" width="900" color="0xE0B34AFF" />
      <Label id="caption" translation="[96, 968]" width="900" color="0xEDE6CAFF" />
      <Label id="star" translation="[96, 890]" width="200" color="0xE0B34AFF" />
    </Group>
    <LyricsPanel id="lyrics" translation="[1060, 330]" />
    <Group id="nowPlaying" visible="false">
      <Poster id="npIcon" uri="pkg:/images/icons/icon-note.png" width="24" height="24" blendColor="0xE0B34AFF" translation="[1600, 940]" />
      <Label id="npEyebrow" translation="[1024, 936]" width="800" horizAlign="right" color="0xE0B34AFF" text="NOW PLAYING" />
      <Label id="npTitle" translation="[924, 970]" width="900" horizAlign="right" color="0xEDE6CAFF" />
    </Group>
    <Group id="paused" visible="false" translation="[960, 540]">
      <Poster uri="pkg:/images/pill.9.png" blendColor="0x0B0E09CC" translation="[-130, -40]" width="260" height="80" />
      <Label id="pausedText" translation="[-130, -40]" width="260" height="80" horizAlign="center" vertAlign="center" color="0xEDE6CAFF" text="❚❚  Paused" />
    </Group>
    <Label id="status" translation="[96, 500]" width="1728" horizAlign="center" wrap="true" color="0xB5AF8CFF" />
    <Group id="hint" translation="[1824, 1004]">
      <KeyHints id="hintKeys" />
    </Group>
    <Group id="optionsHolder" />

    <Animation id="fade" duration="2" easeFunction="inOutQuad">
      <FloatFieldInterpolator id="fadeIn" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="layerA.opacity" />
      <FloatFieldInterpolator id="fadeOut" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="layerB.opacity" />
    </Animation>
    <Animation id="captionFade" duration="0.8" delay="5">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="captionGroup.opacity" />
    </Animation>
    <Animation id="hintFade" duration="0.6" delay="5">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="hint.opacity" />
    </Animation>
    <Timer id="advance" duration="8" repeat="false" />
    <Timer id="loadTimeout" duration="20" repeat="false" />
    <Timer id="clockTimer" duration="15" repeat="true" />
    <Timer id="weatherTimer" duration="900" repeat="true" />
  </children>
  <interface>
    <field id="albumId" type="string" />
    <field id="albumName" type="string" />
    <!-- running as the TV screensaver: no hints, no keys, no keep-awake -->
    <field id="saver" type="boolean" value="false" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="onShown" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/text.brs" />
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/source/photos.brs" />
  <script type="text/brightscript" uri="pkg:/components/SlideshowScreen.brs" />
</component>
