<?xml version="1.0" encoding="utf-8"?>
<!-- Movies or Shows (layout "3"): a slim strip about the focused title with Play / Captions / Details
     and its art on the right, then tabs (Continue, New, Unwatched, A to Z, Genres) over a poster grid.
     A to Z adds a row of filter chips and a row of letters (Sort B, Letters B). -->
<component name="LibraryRoom" extends="Group">
  <children>
    <!-- info strip -->
    <Label id="eyebrow" translation="[96, 0]" width="1200" color="0xD9A066FF" />
    <Label id="title" translation="[96, 30]" width="1240" maxLines="1" color="0xEDE6CAFF" />
    <Label id="overview" translation="[96, 104]" width="1240" wrap="true" maxLines="2" color="0xB5AF8CFF" />
    <Group id="buttons" translation="[96, 178]" />
    <Rectangle translation="[1468, 0]" width="356" height="200" color="0x141A11FF" />
    <Poster id="art" translation="[1468, 0]" width="356" height="200" loadDisplayMode="scaleToZoom" />
    <Poster uri="pkg:/images/fade-left.png" translation="[1468, 0]" width="150" height="200" />

    <!-- tabs -->
    <Group id="tabs" translation="[96, 270]" />

    <!-- A to Z only: filter chips (Sort, Unwatched, Genre, Decade, Clear), then a letter row when sorted by title -->
    <Group id="chips" translation="[96, 326]" visible="false" />
    <Group id="letters" translation="[96, 386]" visible="false" />

    <!-- poster grid: 9 across, slots are reused as you scroll -->
    <Group id="gridClip" translation="[0, 330]" clippingRect="[0, -16, 1920, 620]">
      <Group id="grid" translation="[96, 0]" />
    </Group>
    <Label id="empty" translation="[96, 360]" width="1500" color="0xB5AF8CFF" />
    <Label id="count" translation="[1424, 270]" width="400" horizAlign="right" color="0xB5AF8CFF" />
  </children>
  <interface>
    <field id="kind" type="string" onChange="refresh" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <function name="focusIn" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/dialogs.brs" />
  <script type="text/brightscript" uri="pkg:/components/LibraryRoom.brs" />
</component>
