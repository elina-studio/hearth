<?xml version="1.0" encoding="utf-8"?>
<!-- One HTTP call to Jellyfin. Set method/path/query/body, run, observe "done". -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="method" type="string" value="GET" />
    <field id="path" type="string" />
    <field id="query" type="assocarray" />
    <field id="body" type="assocarray" />
    <field id="tag" type="string" />
    <field id="key" type="string" />
    <field id="status" type="integer" />
    <field id="response" type="assocarray" />
    <field id="ok" type="boolean" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
